# 由 npm run migrate -- 08 生成，请勿手改。
# 几项安全头（CSP / COEP / COOP）故意未加，理由见本文件顶部注释。

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Resource-Policy: cross-origin
  Permissions-Policy: accelerometer=(), camera=(), display-capture=(), geolocation=(self), gyroscope=(), magnetometer=(), microphone=(self), payment=(), usb=(), xr-spatial-tracking=()
  Strict-Transport-Security: max-age=15552000
  Cache-Control: public, max-age=0, must-revalidate

/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/images/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/uploads/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/favicon.ico
  ! Cache-Control
  Cache-Control: public, max-age=604800

/favicon-*.png
  ! Cache-Control
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  ! Cache-Control
  Cache-Control: public, max-age=604800

/icon-*.png
  ! Cache-Control
  Cache-Control: public, max-age=604800

/site.webmanifest
  ! Cache-Control
  Cache-Control: public, max-age=86400

/sitemap-index.xml
  ! Cache-Control
  Cache-Control: public, max-age=3600

/sitemap-*.xml
  ! Cache-Control
  Cache-Control: public, max-age=3600

/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=86400

/admin/*
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
