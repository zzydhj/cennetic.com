{
    "name": "cennetic-static",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Cennetic CNC Machine — static site (Astro + Cloudflare Pages) with a self-hosted content admin at /admin",
    "scripts": {
        "dev": "astro dev",
        "build": "astro build && npm run build -w admin",
        "preview": "astro preview",
        "astro": "astro",
        "migrate": "tsx scripts/migrate/index.ts",
        "stage:media": "tsx scripts/migrate/index.ts 03 09",
        "cms:seed": "tsx scripts/cms/seed-supabase.ts",
        "snapshot": "tsx scripts/cms/snapshot.ts",
        "snapshot:check": "tsx scripts/cms/snapshot.ts --check",
        "verify:parity": "tsx scripts/verify/parity.ts",
        "verify:cms": "tsx scripts/verify/cms-fields.ts",
        "verify:live": "tsx scripts/verify/live.ts",
        "verify": "npm run verify:parity && npm run verify:cms",
        "admin:dev": "npm run dev -w admin",
        "admin:build": "npm run build -w admin"
    },
    "workspaces": [
        "admin"
    ],
    "dependencies": {
        "@astrojs/sitemap": "^3.3.0",
        "@fontsource/albert-sans": "^5.2.5",
        "@fontsource/montserrat": "^5.2.5",
        "astro": "^5.7.13",
        "sharp": "^0.34.2"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.1.7",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^22.15.0",
        "cheerio": "^1.1.0",
        "js-yaml": "^4.1.0",
        "tailwindcss": "^4.1.7",
        "tsx": "^4.19.4",
        "typescript": "^5.8.3"
    }
}