---
/**
 * /contact-us/ —— 代码自有的「锁定页」（内容与文案在 src/content/locked/contact-us.md）。
 *
 * 为什么不让 [slug].astro 兜：联系页要在 hero 与正文之间插入询盘表单组件
 * （带客户端脚本，组装内容后唤起 WhatsApp/mailto），纯静态组合的通用布局
 * 提供不了这个插槽内容。Astro 路由优先级：静态段路由赢过 [slug] 动态路由，
 * 两者共存不会互相遮蔽（与 /news-and-media/ 独立模板同一先例）。
 *
 * 为什么不走后台：全站已取消「页面」这一 CMS 类型（模板结构本来就在代码里，
 * 后台能改的只是几行 meta）；本页正文较长，故仍存为 .md，跟政策页同一机制。
 */
import PageLayout from "@layouts/PageLayout.astro";
import InquiryForm from "@components/ui/InquiryForm.astro";
import { parseLockedPage } from "@lib/locked-page.ts";
import raw from "../content/locked/contact-us.md?raw";

export const prerender = true;

const { data, body } = parseLockedPage(raw);
---

<PageLayout page={{ data }} html={body}>
    <InquiryForm />
</PageLayout>
