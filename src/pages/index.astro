---
/**
 * 首页。按参考站框架重排：满血渐变 Hero + 玻璃数据条、分类图片卡、畅销机型、
 * 图标特性网格、关于(图文+视频)、最新文章、渐变转化大卡。内容全部用真实数据
 * (产品分类 / 产品 / 文章)组装，不搬源站那套 10 万字符 Elementor DOM。
 *
 * 布局约定：section 全出血负责背景色带与纵向节奏，内部只放一层 .shell 控制宽度。
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import ArticleCard from "@components/ui/ArticleCard.astro";
import ProductCard from "@components/ui/ProductCard.astro";
import HeroVideo from "@components/ui/HeroVideo.astro";
import YouTubeEmbed from "@components/ui/YouTubeEmbed.astro";
import { getCollection } from "astro:content";
import { allArticles } from "@lib/content.ts";
import { siteConfig, allProducts, megaMenu } from "@lib/catalog.ts";
import { waLink } from "@lib/whatsapp.ts";

export const prerender = true;

const home = (await getCollection("pages")).find((p) => p.data.slug === "home");
const articles = await allArticles();
const products = allProducts();

const latest = articles.slice(0, 3);
const popular = products.slice(0, 4);
// 分类卡用 megaMenu 派生的代表机型图 + 真实计数
const cats = megaMenu();

const wa = waLink(
    { number: siteConfig.whatsapp.number, siteUrl: siteConfig.url },
    { text: "Hi Cennetic, I would like a quote for CNC machines." },
);

const heroImage = popular[0]?.images[0] ?? null;
const description = home?.data.description || siteConfig.description;
const lcpImage = siteConfig.hero.poster;
---

<BaseLayout
    isHome
    title="Cennetic CNC Machine"
    description={description}
    path="/"
    ogImage={heroImage?.src}
    pageType="home"
    preloadLcpImage={lcpImage}
>
    <!-- ── Hero：满血渐变 + 视频背景 + 玻璃数据条 ── -->
    <section class="band-hero">
        <HeroVideo variant="fill" />
        <div class="hero-scrim" aria-hidden="true"></div>
        <div class="hero-glow" aria-hidden="true"></div>

        <div class="shell hero">
            <div class="hero-copy">
                <span class="hero-eyebrow">
                    <svg
                        width="15"
                        height="15"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        aria-hidden="true"
                        ><path
                            d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path></svg
                    >
                    {siteConfig.shortName} · Dongguan, China
                </span>
                <h1>
                    High-Precision <span class="hl">CNC Machining</span> Solutions
                </h1>
                <p class="lede">
                    A true source factory — not a trading company. We engineer
                    and build machining centers, drilling &amp; tapping centers
                    and CNC lathes, and ship them direct to factories across
                    Europe, North America and Southeast Asia.
                </p>
                <p class="actions">
                    <a
                        class="btn btn-light btn-lg"
                        href={wa}
                        rel="noopener noreferrer"
                        target="_blank">Get a Quick Quote</a
                    >
                    <a class="btn btn-outline-light btn-lg" href="/products/"
                        >Explore Products</a
                    >
                </p>
                <ul class="badges">
                    <li>ISO-grade build</li>
                    <li>2-year warranty</li>
                    <li>CE / SGS</li>
                    <li>Global install &amp; support</li>
                </ul>
            </div>
        </div>

        <dl class="hero-stats">
            <div class="shell hero-stats-inner">
                <div><dt>15+</dt><dd>Years manufacturing</dd></div>
                <div><dt>750+</dt><dd>Factories served</dd></div>
                <div><dt>2-yr</dt><dd>Machine warranty</dd></div>
                <div><dt>3</dt><dd>Continents exported</dd></div>
            </div>
        </dl>
    </section>

    <!-- ── 分类：图片卡 ── -->
    <section class="section" aria-labelledby="cats-h">
        <div class="shell">
            <div class="section-head">
                <p class="eyebrow">Machine categories</p>
                <h2 id="cats-h" class="section-title">
                    Built for the job you actually run
                </h2>
                <p class="section-sub">
                    Every category is manufactured in our own facility, with the
                    spindle, control and guideway options we would put on our
                    own production floor.
                </p>
            </div>
            <ul class="cat-grid">
                {
                    cats.map((c) => (
                        <li>
                            <a class="cat-card" href={c.path}>
                                {c.thumb && (
                                    <img
                                        src={c.thumb}
                                        alt=""
                                        loading="lazy"
                                        decoding="async"
                                    />
                                )}
                                <span class="cat-card-ov">
                                    <span class="cat-card-name">{c.name}</span>
                                    <span class="cat-card-cta">
                                        {c.count} models →
                                    </span>
                                </span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <!-- ── 畅销机型 ── -->
    {
        popular.length > 0 && (
            <section class="section section--alt" aria-labelledby="best-h">
                <div class="shell">
                    <div class="section-head">
                        <p class="eyebrow">Best sellers</p>
                        <h2 id="best-h" class="section-title">
                            Popular models
                        </h2>
                        <p class="section-sub">
                            Factory-direct machines our customers specify most
                            often.
                        </p>
                    </div>
                    <div class="grid" data-count={popular.length}>
                        {popular.map((p, i) => (
                            <ProductCard product={p} eager={i === 0} />
                        ))}
                    </div>
                    <p class="more">
                        <a class="btn btn-ghost btn-sm" href="/products/">
                            View all products
                        </a>
                    </p>
                </div>
            </section>
        )
    }

    <!-- ── 为何选我们：图标网格 ── -->
    <section class="section" aria-labelledby="why-h">
        <div class="shell">
            <div class="section-head">
                <p class="eyebrow eyebrow--accent">Why Cennetic</p>
                <h2 id="why-h" class="section-title">
                    What you get buying direct from the builder
                </h2>
            </div>
            <ul class="feat-grid">
                <li class="feat">
                    <span class="feat-ic"
                        ><svg
                            width="26"
                            height="26"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            ><path
                                d="M3 21h18M5 21V8l5 3V8l5 3V6l4 2v13"
                                stroke-linecap="round"
                                stroke-linejoin="round"></path></svg
                        ></span
                    >
                    <h3>Direct source factory</h3>
                    <p>
                        We machine, assemble and test in our own Dongguan plant
                        — you deal with the builder, not a reseller.
                    </p>
                </li>
                <li class="feat">
                    <span class="feat-ic"
                        ><svg
                            width="26"
                            height="26"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            ><path
                                d="M12 13l4-4M12 3a9 9 0 100 18 9 9 0 000-18z"
                                stroke-linecap="round"
                                stroke-linejoin="round"></path></svg
                        ></span
                    >
                    <h3>Precision you can verify</h3>
                    <p>
                        Guideway and box-way VMCs, 5-axis and turn-mill centres
                        built to rated accuracy and checked before shipping.
                    </p>
                </li>
                <li class="feat">
                    <span class="feat-ic"
                        ><svg
                            width="26"
                            height="26"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            ><path
                                d="M12 3l7 3v6c0 4-3 6-7 9-4-3-7-5-7-9V6l7-3z"
                                stroke-linecap="round"
                                stroke-linejoin="round"></path></svg
                        ></span
                    >
                    <h3>2-year machine warranty</h3>
                    <p>
                        Spindle, guideway and structural cover, plus lifetime
                        access to consumables, tooling and spares.
                    </p>
                </li>
                <li class="feat">
                    <span class="feat-ic"
                        ><svg
                            width="26"
                            height="26"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            ><path
                                d="M4 13a8 8 0 0116 0M4 13v3a2 2 0 002 2h1v-5H6a2 2 0 00-2 2zm16 0v3a2 2 0 01-2 2h-1v-5h1a2 2 0 012 2z"
                                stroke-linecap="round"
                                stroke-linejoin="round"></path></svg
                        ></span
                    >
                    <h3>Install, training &amp; support</h3>
                    <p>
                        Commissioning, operator training and remote diagnostics
                        from the engineers who built your machine.
                    </p>
                </li>
                <li class="feat">
                    <span class="feat-ic"
                        ><svg
                            width="26"
                            height="26"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            ><path
                                d="M4 5h16v14H4zM4 9h16M8 5v14"
                                stroke-linecap="round"
                                stroke-linejoin="round"></path></svg
                        ></span
                    >
                    <h3>Application review</h3>
                    <p>
                        Send a drawing — we recommend the model, fixture and
                        tooling path for your part and monthly volume.
                    </p>
                </li>
                <li class="feat">
                    <span class="feat-ic"
                        ><svg
                            width="26"
                            height="26"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            ><path
                                d="M12 3a9 9 0 100 18 9 9 0 000-18zM3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"
                                stroke-linecap="round"
                                stroke-linejoin="round"></path></svg
                        ></span
                    >
                    <h3>Global export experience</h3>
                    <p>
                        15+ years shipping to Europe, North America and
                        Southeast Asia, with export documentation handled.
                    </p>
                </li>
            </ul>
        </div>
    </section>

    <!-- ── 关于：图文 + 视频 ── -->
    <section class="section section--tint" aria-labelledby="about-h">
        <div class="shell two">
            <div class="about-copy">
                <p class="eyebrow">About {siteConfig.shortName}</p>
                <h2 id="about-h" class="section-title">
                    Your direct source for precision CNC manufacturing
                </h2>
                <p>
                    CENNETIC is a manufacturer and innovator of high-precision
                    CNC machine tools in China. We engineer, build and deliver
                    top-tier, high-efficiency machining solutions worldwide —
                    the engineers who build your machine are the ones who
                    support it.
                </p>
                <ul class="ticks">
                    <li>Direct factory pricing, no trading-company markup</li>
                    <li>GD&amp;T and application review before you order</li>
                    <li>
                        Installation, training and remote diagnostics included
                    </li>
                    <li>
                        Consumables, tooling and spares for the machine's life
                    </li>
                </ul>
                <p class="actions">
                    <a
                        class="btn btn-primary btn-sm"
                        href={wa}
                        rel="noopener noreferrer"
                        target="_blank">Get a Quick Quote</a
                    >
                    <a class="btn btn-ghost btn-sm" href="/service/"
                        >How we support you</a
                    >
                </p>
            </div>
            <figure class="frame">
                <YouTubeEmbed
                    title="Inside the Cennetic CNC machine factory"
                    alt="Cennetic factory tour video"
                />
            </figure>
        </div>
    </section>

    <!-- ── 最新文章 ── -->
    {
        latest.length > 0 && (
            <section class="section" aria-labelledby="art-h">
                <div class="shell">
                    <div class="section-head">
                        <p class="eyebrow">Useful articles</p>
                        <h2 id="art-h" class="section-title">
                            Technical guides from the shop floor
                        </h2>
                    </div>
                    <div class="grid" data-count={latest.length}>
                        {latest.map((a) => (
                            <ArticleCard article={a} />
                        ))}
                    </div>
                    <p class="more">
                        <a class="btn btn-ghost btn-sm" href="/blog/">
                            All articles
                        </a>
                    </p>
                </div>
            </section>
        )
    }

    <!-- ── 转化大卡：渐变 ── -->
    <section class="section" aria-labelledby="contact-h">
        <div class="shell">
            <div class="cta-grad">
                <div class="cta-grad-glow" aria-hidden="true"></div>
                <div class="cta-grad-main">
                    <p class="eyebrow eyebrow--glass">Contact us</p>
                    <h2 id="contact-h" class="section-title">
                        Send us your part drawing
                    </h2>
                    <p>
                        Tell us the material, part size, tolerance and monthly
                        volume — we will recommend a configuration and send
                        pricing on WhatsApp.
                    </p>
                    <p class="actions">
                        <a
                            class="btn btn-wa"
                            href={wa}
                            rel="noopener noreferrer"
                            target="_blank"
                            >WhatsApp {siteConfig.whatsapp.display}</a
                        >
                        <a
                            class="btn btn-outline-light"
                            href={`mailto:${siteConfig.email}`}>Email us</a
                        >
                    </p>
                </div>
                <div class="cta-grad-side">
                    <p class="cta-side-title">What to include</p>
                    <ul class="cta-list">
                        <li>Material and hardness</li>
                        <li>Part size and key tolerances</li>
                        <li>Monthly or total quantity</li>
                        <li>Target cycle time or surface finish</li>
                    </ul>
                    <p class="cta-note">
                        STEP, DXF, PDF or IGES accepted. Replies within one
                        business day.
                    </p>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    /* ── Hero ── */
    .band-hero {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        background: var(--color-brand-deep);
        padding-top: clamp(4rem, 9vw, 7rem);
    }
    .hero-scrim {
        position: absolute;
        inset: 0;
        z-index: 0;
        background: linear-gradient(
            135deg,
            rgb(1 15 46 / 0.86) 0%,
            rgb(1 39 96 / 0.72) 48%,
            rgb(0 150 180 / 0.55) 120%
        );
    }
    .hero-glow {
        position: absolute;
        inset: 0;
        z-index: 0;
        background-image:
            linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px),
            linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px);
        background-size: 44px 44px;
        mask-image: radial-gradient(
            circle at 78% 12%,
            #000 0%,
            transparent 70%
        );
    }
    .hero {
        position: relative;
        z-index: 1;
        padding-bottom: clamp(3rem, 6vw, 5rem);
    }
    .hero-copy {
        max-width: 44rem;
    }
    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.4rem 0.9rem;
        border-radius: var(--radius-pill);
        background: rgb(255 255 255 / 0.14);
        border: 1px solid rgb(255 255 255 / 0.28);
        backdrop-filter: blur(6px);
        color: #fff;
        font-size: 0.82rem;
        font-weight: 600;
    }
    .hero-eyebrow svg {
        color: var(--color-accent-on-dark);
    }
    .band-hero h1 {
        color: #fff;
        font-size: clamp(2.1rem, 1.4rem + 3.4vw, 3.5rem);
        line-height: 1.1;
        letter-spacing: -0.02em;
        margin: 1.1rem 0 1rem;
    }
    .band-hero h1 .hl {
        background: linear-gradient(90deg, #4fd0ee, #9ec5f0);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }
    .lede {
        font-size: clamp(1rem, 0.9rem + 0.5vw, 1.15rem);
        line-height: 1.7;
        color: rgb(255 255 255 / 0.86);
        max-width: 38rem;
        margin: 0 0 1.8rem;
    }
    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        margin: 0;
    }
    .badges {
        list-style: none;
        margin: 1.8rem 0 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    .badges li {
        padding: 0.3rem 0.75rem;
        border-radius: var(--radius-pill);
        background: rgb(255 255 255 / 0.1);
        border: 1px solid rgb(255 255 255 / 0.2);
        color: rgb(255 255 255 / 0.92);
        font-size: 0.78rem;
        font-weight: 600;
    }
    .hero-stats {
        position: relative;
        z-index: 1;
        margin: 0;
    }
    .hero-stats-inner {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1px;
        background: rgb(255 255 255 / 0.16);
        border-top: 1px solid rgb(255 255 255 / 0.16);
        padding-inline: 0;
        max-width: none;
    }
    .hero-stats div {
        background: rgb(13 10 55 / 0.28);
        backdrop-filter: blur(4px);
        padding: clamp(1.1rem, 3vw, 1.9rem) 0.75rem;
        text-align: center;
    }
    .hero-stats dt {
        font-family: var(--font-display);
        font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.3rem);
        font-weight: 800;
        line-height: 1;
        color: #fff;
    }
    .hero-stats dd {
        margin: 0.5rem 0 0;
        font-size: 0.82rem;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        color: rgb(255 255 255 / 0.72);
    }

    /* ── 区块通用 ── */
    .section {
        padding-block: var(--section-y);
    }
    .section--alt {
        background: var(--color-surface);
    }
    .section--tint {
        background: var(--color-brand-tint);
    }
    .section-head {
        text-align: center;
        max-width: 44rem;
        margin: 0 auto clamp(2rem, 4vw, 3rem);
    }

    /* ── 分类图片卡 ── */
    .cat-grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
        gap: clamp(0.9rem, 2vw, 1.4rem);
    }
    .cat-card {
        position: relative;
        display: block;
        aspect-ratio: 3 / 2;
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        background: var(--color-brand-deep);
        transition:
            box-shadow var(--dur) var(--ease),
            transform var(--dur) var(--ease);
    }
    .cat-card img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s var(--ease);
    }
    .cat-card:hover {
        box-shadow: var(--shadow);
        transform: translateY(-4px);
    }
    .cat-card:hover img {
        transform: scale(1.06);
    }
    .cat-card-ov {
        position: absolute;
        inset: auto 0 0 0;
        padding: 2.4rem 1rem 0.9rem;
        background: linear-gradient(transparent, rgb(1 15 46 / 0.85));
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
    }
    .cat-card-name {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1rem;
        line-height: 1.3;
    }
    .cat-card-cta {
        flex-shrink: 0;
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--color-accent-on-dark);
    }

    /* ── 网格(产品/文章) ── */
    .grid {
        display: grid;
        gap: var(--gutter);
    }
    .grid[data-count="4"] {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .grid[data-count="3"] {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    @media (width <= 1080px) {
        .grid[data-count="4"] {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
    @media (width <= 720px) {
        .grid[data-count="3"],
        .grid[data-count="4"] {
            grid-template-columns: minmax(0, 1fr);
        }
    }
    .more {
        margin: 2rem 0 0;
        text-align: center;
    }

    /* ── 特性图标网格 ── */
    .feat-grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: clamp(0.9rem, 2vw, 1.4rem);
    }
    .feat {
        border: 1px solid var(--color-line);
        border-radius: var(--radius);
        background: var(--color-paper);
        padding: clamp(1.4rem, 2.4vw, 1.9rem);
        transition:
            box-shadow var(--dur) var(--ease),
            transform var(--dur) var(--ease),
            border-color var(--dur) var(--ease);
    }
    .feat:hover {
        box-shadow: var(--shadow);
        border-color: rgb(1 39 96 / 0.25);
        transform: translateY(-4px);
    }
    .feat-ic {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 54px;
        height: 54px;
        border-radius: 16px;
        background: var(--gradient-soft);
        color: var(--color-brand);
        margin-bottom: 1rem;
    }
    .feat h3 {
        font-size: 1.08rem;
        margin: 0 0 0.45rem;
    }
    .feat p {
        font-size: 0.9rem;
        line-height: 1.6;
        color: var(--color-muted);
        margin: 0;
    }

    /* ── 关于 ── */
    .two {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
        gap: clamp(1.75rem, 4vw, 3.5rem);
        align-items: center;
    }
    .about-copy .section-title {
        margin-top: 0.4rem;
    }
    .about-copy > p:not(.actions, .eyebrow) {
        color: var(--color-body);
        line-height: 1.75;
        margin: 0 0 1.2rem;
    }
    .ticks {
        list-style: none;
        margin: 0 0 1.6rem;
        padding: 0;
        display: grid;
        gap: 0.6rem;
        font-size: 0.95rem;
        color: var(--color-body);
    }
    .ticks li {
        position: relative;
        padding-left: 1.9rem;
    }
    .ticks li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.15rem;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: var(--color-accent-soft);
    }
    .ticks li::after {
        content: "";
        position: absolute;
        left: 5px;
        top: 0.42rem;
        width: 8px;
        height: 4px;
        border-left: 2px solid var(--color-accent-dark);
        border-bottom: 2px solid var(--color-accent-dark);
        transform: rotate(-45deg);
    }
