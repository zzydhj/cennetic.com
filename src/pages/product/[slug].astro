---
/**
 * /product/<slug>/ 产品详情页。
 *
 * 询盘型展示站，所以这里不输出价格与加购 —— 源站的 WooCommerce 交易链路
 * 随纯静态化一起下线。转化统一走带型号上下文的 WhatsApp 深链。
 *
 * 页头用共享 PageHero（slim：面包屑 + 分类 + 型号名）；其下是「画廊 + 信息列」，
 * 再往下是迁移正文（规格/配置表）、公司通版区、相关产品。结构化数据只输出 Product
 * 基础字段：没有真实报价就不编造 offers/price（虚构价格是 Google 手动处罚项）。
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/layout/PageHero.astro";
import Gallery from "@components/product/Gallery.astro";
import ProductCard from "@components/ui/ProductCard.astro";
import Faq from "@components/ui/Faq.astro";
import ProductCompanySections from "@components/product/ProductCompanySections.astro";
/* 详情区是迁移 HTML（qf-* 类名），基础排版靠这层样式 */
import "../../styles/article.css";
import {
    siteConfig,
    getProduct,
    allProducts,
    categoryAncestors,
    productCategories,
} from "@lib/catalog.ts";
import { waLink } from "@lib/whatsapp.ts";
import type { GetStaticPaths } from "astro";

export const prerender = true;

export const getStaticPaths: GetStaticPaths = async () =>
    allProducts().map((p) => ({ params: { slug: p.slug } }));

const product = getProduct(Astro.params.slug!);
if (!product) return Astro.redirect("/404/");

const cover = product.images[0];
const category = product.categories[0];
const catRecord = productCategories.find((c) => c.slug === category?.slug);
const ancestors = catRecord ? categoryAncestors(catRecord) : [];

const crumbs = [
    { name: "Home", path: "/" },
    { name: "Products", path: "/products/" },
    ...ancestors.map((a) => ({ name: a.name, path: a.canonical })),
    ...(category && !ancestors.some((a) => a.slug === category.slug)
        ? [{ name: category.name, path: category.canonical }]
        : []),
    { name: product.name, path: product.canonical },
];

const wa = waLink(
    { number: siteConfig.whatsapp.number, siteUrl: siteConfig.url },
    {
        subject: `${product.name} (${siteConfig.url}${product.canonical})`,
    },
);

// 同分类优先，避免相关产品里出现自己
const others = allProducts()
    .filter((p) => p.slug !== product.slug)
    .sort((a, b) => {
        const an = a.categories.some((c) =>
            product.categories.some((pc) => pc.slug === c.slug),
        )
            ? 0
            : 1;
        const bn = b.categories.some((c) =>
            product.categories.some((pc) => pc.slug === c.slug),
        )
            ? 0
            : 1;
        return an - bn;
    })
    .slice(0, 3);

const description = `${product.name} by Cennetic — ${product.summary
    .replace(/<[^>]+>/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .slice(0, 150)}`;
---

<BaseLayout
    title={`${product.name} | CENNETIC CNC`}
    description={description.slice(0, 255)}
    path={product.canonical}
    ogImage={cover?.src}
    ogImageWidth={cover?.width}
    ogImageHeight={cover?.height}
    breadcrumb={crumbs}
    pageType="product"
    faq={product.faq}
    product={{
        name: product.name,
        description,
        images: product.images.map((i) => i.src),
        categories: product.categories.map((c) => c.name),
    }}
    preloadLcpImage={cover?.src}
>
    <PageHero
        title={product.name}
        crumbs={crumbs}
        eyebrow={product.categories.map((c) => c.name).join(" · ")}
        slim
    />

    <div class="shell product-page">
        <div class="product">
            <Gallery images={product.images} name={product.name} />

            <div class="info">
                {
                    product.summary && (
                        <div class="sum" set:html={product.summary} />
                    )
                }

                <p class="actions">
                    <a
                        class="btn btn-wa"
                        href={wa}
                        rel="noopener noreferrer"
                        target="_blank">Get a Quote on WhatsApp</a
                    >
                    <a class="btn btn-ghost" href={`mailto:${siteConfig.email}`}
                        >Email us</a
                    >
                </p>

                <ul class="assure">
                    <li>Direct source factory — no trading-company markup</li>
                    <li>2-year warranty on all major components</li>
                    <li>Setup, training and remote diagnostics included</li>
                </ul>
            </div>
        </div>

        {
            product.body && (
                <section class="detail" aria-labelledby="detail-h">
                    <h2 id="detail-h">Product details</h2>
                    <div class="qf-article-body" set:html={product.body} />
                </section>
            )
        }

        {(product.faq?.length ?? 0) > 0 && <Faq items={product.faq!} />}

        {
            /*
          公司通版内容区:与型号无关的工厂自我介绍(承诺/系列/车间/检测/全球合作/CTA),
          做成共享组件构建时渲染进每个产品页 —— 单一事实源、不写进各 products.body、
          零运行时。解决详情页内容太薄的问题。
        */
        }
        <ProductCompanySections productName={product.name} />

        {
            others.length > 0 && (
                <section class="also" aria-labelledby="also-h">
                    <h2 id="also-h">Other models</h2>
                    <div class="grid">
                        {others.map((p) => (
                            <ProductCard product={p} />
                        ))}
                    </div>
                </section>
            )
        }
    </div>
</BaseLayout>

<style>
    .product-page {
        padding-bottom: 1rem;
    }

    .product {
        display: grid;
        /* 图库拿到更多空间：机型照片的细节（刀库、卡盘、床身）在小图里看不清楚 */
        grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
        gap: clamp(1.5rem, 4vw, 3.5rem);
        align-items: start;
    }

    /* 宽屏下图库随页滚动保持可见，读参数时不用来回滚 */
    @media (width >= 1024px) {
        .product :global(.gallery) {
            position: sticky;
            top: 5.5rem;
        }
    }

    .info {
        min-width: 0;
    }

    .sum {
        font-size: 0.98rem;
        color: var(--color-body);
        line-height: 1.75;
    }

    .sum :global(p) {
        margin: 0 0 0.7rem;
    }
    .sum :global(strong) {
        color: var(--color-ink);
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin: 1.4rem 0 0;
    }

    .assure {
        list-style: none;
        margin: 1.5rem 0 0;
        padding: 1.1rem 1.15rem;
        border: 1px solid var(--color-line);
        border-radius: var(--radius);
        background: var(--color-surface);
        font-size: 0.85rem;
        color: var(--color-body);
        display: grid;
        gap: 0.45rem;
    }

    .assure li {
        padding-left: 1.15rem;
        position: relative;
    }

    .assure li::before {
        content: "✓";
        position: absolute;
        left: 0;
        color: var(--color-good);
        font-weight: 700;
    }

    .detail,
    .also {
        margin-top: 3rem;
        padding-top: 1.75rem;
        border-top: 1px solid var(--color-line);
    }

    .detail h2,
    .also h2 {
        font-size: 1.3rem;
        margin: 0 0 1.1rem;
    }

    /*
     * 产品正文外层与下方公司通版区同宽(全栏);文字段落限 75ch 保证可读,表格/图片铺满。
     */
    .detail {
        max-width: none;
    }

    /*
     * 正文由 CMS 以 set:html 注入,子元素不带 Astro 作用域属性;整条选择器必须全部
     * 放进 :global(),否则 Astro 会把 [data-astro-cid] 加到末端元素上命中 0 个。
     */
    :global(.detail .qf-article-body > p),
    :global(.detail .qf-article-body > ul),
    :global(.detail .qf-article-body > ol),
    :global(.detail .qf-article-body > blockquote) {
        max-width: 75ch;
    }

    /*
     * 正文里的规格表做成“像样”的规格清单：深色表头 + 边框 + 斑马纹。
     * 分组行标题(Bed/Electrical)是 tbody 里的 td rowspan,不会误染。
     */
    :global(.detail .qf-article-body table) {
        width: 100%;
        max-width: 100%;
        border-collapse: collapse;
        font-size: 0.92rem;
        margin: 1.1rem 0 1.9rem;
    }

    :global(.detail .qf-article-body th),
    :global(.detail .qf-article-body td) {
        border: 1px solid var(--color-line);
        padding: 0.62rem 0.85rem;
        text-align: left;
        vertical-align: top;
    }

    :global(.detail .qf-article-body thead th) {
        background: var(--gradient);
        color: #fff;
        font-family: var(--font-display);
        font-weight: 600;
    }

    :global(.detail .qf-article-body tbody tr:nth-child(even)) {
        background: var(--color-surface);
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
        gap: var(--gutter);
        margin-top: 1.25rem;
    }

    @media (width <= 880px) {
        .product {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }
    }
</style>
