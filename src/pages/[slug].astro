---
/**
 * 顶级单段路径的唯一入口 —— 文章 /<slug>/。
 *
 * 这里以前同时承接「非列表型页面」，两类内容合用一条动态路由是因为它们在源站都是
 * 顶级单段路径：若各写一个 [slug].astro 与 [page].astro，Astro 会按文件名顺序静默
 * 遮蔽其中一个，表现是「某些文章莫名 404」且构建不报错。
 *
 * 后台的「页面」这一内容类型已整体取消（模板结构本来就在代码里，后台能改的只有几行
 * meta），现在每个页面都有自己的静态路由：首页 index.astro，列表页 blog / category /
 * products / shop / news-and-media，公司与政策页 about-us / service / privacy-policy /
 * cnc-machine-refund-policy / contact-us。于是双类型合路、slug 冲突断言、以及「同一个
 * URL 被后台行与代码路由各渲染一次 → 样式清单错拿」这一整类事故都不再有可能发生。
 *
 * 重复 slug 不在这里兜：Astro 对相同 params 会直接构建失败，比静默少生成一页好。
 */
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import ArticleLayout from "@layouts/ArticleLayout.astro";
import { allArticles, relatedArticles } from "@lib/content.ts";

export const prerender = true;

type ArticleEntry = CollectionEntry<"articles">;

export async function getStaticPaths() {
    const articles = await getCollection("articles");
    const pool = await allArticles();
    return articles.map((entry) => ({
        params: { slug: entry.data.slug },
        props: {
            entry: entry as ArticleEntry,
            related: relatedArticles(entry as ArticleEntry, pool, 4),
        },
    }));
}

const { entry, related } = Astro.props as {
    entry: ArticleEntry;
    related: ArticleEntry[];
};

/**
 * 正文取 entry.body 原始 HTML 直接渲染，不走 Markdown 编译。
 * 原因见 content.config.ts 顶部：正文含大量 qf-* 组件类名，Markdown 往返会丢。
 */
const html = (entry as unknown as { body?: string }).body?.trim() ?? "";
---

<ArticleLayout article={entry} html={html} related={related} />
