---
/**
 * /product-category/<a>/<b>/<c>/ —— 任意深度的产品分类页。
 *
 * 源站实测最深三级（machining-centers / vertical-machining-centers /
 * vertical-machining-centers-3-linear-guideway），且三级都返回 200 并被 index。
 * 用 [...tree] 通配剩余路径，避免为每种深度各写一个路由而漏掉某一层。
 *
 * 空分类（源站有 4 个产品数为 0 的分类，Store API 不返回它们）也要出页面 ——
 * 它们已被 Google 收录，不建就是 404。
 */
import ArchiveLayout from "@layouts/ArchiveLayout.astro";
import ProductCard from "@components/ui/ProductCard.astro";
import {
    productCategories,
    childCategories,
    productsInCategory,
    categoryAncestors,
    type ProductCategory,
} from "@lib/catalog.ts";
import { siteConfig } from "@lib/catalog.ts";

export const prerender = true;

export async function getStaticPaths() {
    return productCategories.map((cat) => ({
        params: { tree: cat.trail.join("/") },
        props: { cat },
    }));
}

const cat = Astro.props.cat as ProductCategory;
const mine = productsInCategory(cat.slug);
// 父分类页要能往下走，否则空分类页就成了死胡同
const kids = childCategories(cat.slug);
const ancestors = categoryAncestors(cat);

const crumbs = [
    { name: "Home", path: "/" },
    { name: "Products", path: "/products/" },
    ...ancestors.map((a) => ({ name: a.name, path: a.canonical })),
    { name: cat.name, path: cat.canonical },
];

const blurb = cat.description
    .replace(/<[^>]+>/g, " ")
    .replace(/\s+/g, " ")
    .trim();

// 分类图可能指向源站已删除的文件，读不到就不输出
const hero = cat.image
    ? `/images/${cat.image.replace(/^\/wp-content\/uploads\//, "")}`
    : undefined;
---

<ArchiveLayout
    title={cat.title || `${cat.name} - ${siteConfig.name}`}
    description={blurb ||
        `${cat.name} — direct from the QiaoFeng factory. Get specifications and a quote on WhatsApp.`}
    heading={cat.name}
    path={cat.canonical}
    robots={cat.robots}
    crumbs={crumbs}
    pageType="category"
    ogImage={hero ?? siteConfig.ogDefaultImage}
>
    {
        mine.length > 0 ? (
            <div class="grid">
                {mine.map((p) => (
                    <ProductCard product={p} />
                ))}
            </div>
        ) : kids.length > 0 ? (
            <ul class="subs">
                {kids.map((k) => (
                    <li>
                        <a href={k.canonical}>{k.name}</a>
                    </li>
                ))}
            </ul>
        ) : (
            <p class="none">
                This category is being updated. Tell us what you need to machine
                and we will recommend a model directly.
            </p>
        )
    }

    {
        mine.length > 0 && kids.length > 0 && (
            <section class="nested" aria-labelledby="nested-h">
                <h2 id="nested-h">Subcategories</h2>
                <ul class="subs">
                    {kids.map((k) => (
                        <li>
                            <a href={k.canonical}>{k.name}</a>
                        </li>
                    ))}
                </ul>
            </section>
        )
    }
</ArchiveLayout>

<style>
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1.25rem;
    }

    .subs {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 0.6rem;
    }

    .subs a {
        display: block;
        padding: 1rem 1.1rem;
        border: 1px solid var(--color-line);
        border-radius: var(--radius);
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 0.92rem;
        color: var(--color-ink);
    }

    .subs a:hover {
        border-color: var(--color-brand);
        color: var(--color-brand);
    }

    .nested {
        margin-top: 2.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-line);
    }

    .nested h2 {
        font-size: 1.15rem;
        margin: 0 0 0.9rem;
    }

    .none {
        color: var(--color-muted);
        font-size: 0.95rem;
        max-width: 60ch;
    }
</style>
