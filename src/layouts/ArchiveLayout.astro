---
/**
 * 列表页骨架：文章列表、产品分类页、博客分类页共用。
 *
 * 页头统一用共享 PageHero（深色渐变带 + 面包屑），列表内容放其后的 .shell。
 * 分页存在的前提是 URL 与源站逐条对齐 —— /blog/page/N/ 与 /category/x/page/N/
 * 实测在源站都返回 200 且 index，Google 可能已收录，少建一页就是 404。
 */
import BaseLayout from "./BaseLayout.astro";
import PageHero from "@components/layout/PageHero.astro";
import Pager from "@components/ui/Pager.astro";
import Faq from "@components/ui/Faq.astro";
import type { Crumb } from "@components/ui/Breadcrumb.astro";
import type { Pagination } from "@lib/content.ts";
import { siteConfig } from "@lib/catalog.ts";

interface Props {
    title: string;
    description: string;
    heading: string;
    path: string;
    crumbs: Crumb[];
    intro?: string;
    /** 列表页 own 的 robots，来自源站清单逐条对齐（空分类是 noindex） */
    robots?: string;
    pagination?: Pagination;
    basePath?: string;
    total?: number;
    noun?: string;
    pageType?: "archive" | "category" | "page";
    ogImage?: string;
    faq?: Array<{ q: string; a: string }>;
    /** 保留位（历史上限制描述区行长）；页头改 PageHero 后不再需要 */
    narrowIntro?: boolean;
}

const {
    title,
    description,
    heading,
    path,
    crumbs,
    intro,
    robots = "follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large",
    pagination,
    basePath,
    total,
    noun = "articles",
    pageType = "archive",
    ogImage,
    faq,
} = Astro.props;
---

<BaseLayout
    title={title}
    description={description}
    path={path}
    robots={robots}
    ogImage={ogImage ?? siteConfig.ogDefaultImage}
    breadcrumb={crumbs}
    pageType={pageType}
    faq={faq}
>
    <PageHero
        title={heading}
        crumbs={crumbs}
        ledeHtml={intro}
        lede={intro ? undefined : description}
    />

    <div class="shell archive-body">
        <slot />

        {
            faq?.length && (
                <div class="faq-wrap">
                    <Faq items={faq} />
                </div>
            )
        }

        {
            pagination && basePath && total !== undefined && (
                <Pager
                    basePath={basePath}
                    pagination={pagination}
                    total={total}
                    noun={noun}
                />
            )
        }
    </div>
</BaseLayout>

<style>
    .archive-body {
        padding-bottom: 1rem;
    }
    .faq-wrap {
        max-width: 880px;
        margin-top: 2.5rem;
    }
</style>
