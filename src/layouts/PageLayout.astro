---
/**
 * 普通页面正文布局（About Us / Service / Contact / Privacy / Refund 等）。
 *
 * 正文同样是迁移后的 HTML。与文章布局的差别只有两点：
 * 不生成目录、不显示作者卡与阅读时长 —— 政策页和公司页挂作者署名是不合逻辑的。
 * isListing 的页面（/shop/ /products/ 等）不走这里，由各自的列表模板处理。
 */
import BaseLayout from "./BaseLayout.astro";
import Breadcrumb from "@components/ui/Breadcrumb.astro";
import Faq from "@components/ui/Faq.astro";
/* 页面正文与文章同源（迁移 HTML + qf-* 类名），缺了这层样式正文会裸奔 */
import "../styles/article.css";
/* 营销页分区组件（pg-*）：正文带 pg-page 标记的页面走宽版版式 */
import "../styles/page.css";
import { siteConfig } from "@lib/catalog.ts";
import { entryPath } from "@lib/content.ts";
import { waLink } from "@lib/whatsapp.ts";
import type { CollectionEntry } from "astro:content";

interface Props {
    page: CollectionEntry<"pages">;
    /** 正文原始 HTML */
    html: string;
    /** 分类式页面（如 /news-and-media/）会在正文后再插列表区 */
    afterBody?: boolean;
}

const { page, html, afterBody = false } = Astro.props;
const d = page.data;
// 后台新建的页面可能没填 canonical，由 entryPath 按 slug 兜底
const selfPath = entryPath(d);

/*
 * 宽版模式开关：正文以 <div class="pg-page"> 开头的页面（About/Contact 等营销页）
 * 走 friway 式宽版版式（hero 带 + 通栏分区）；其余页面（政策页等纯长文）
 * 仍走 76ch 阅读列，两者共用这一个布局，靠内容标记自选。
 */
const wide = /class="pg-page"/.test(html);

const crumbs = [
    { name: "Home", path: "/" },
    ...(d.slug === "home" ? [] : [{ name: d.title, path: selfPath }]),
];

const wa = waLink(
    { number: siteConfig.whatsapp.number, siteUrl: siteConfig.url },
    { subject: d.title },
);
---

<BaseLayout
    title={d.title}
    description={d.description}
    path={selfPath}
    robots={d.robots}
    ogImage={d.hero}
    breadcrumb={crumbs}
    pageType="page"
    faq={d.faq}
    preloadLcpImage={d.hero}
>
    <div class="page shell">
        <Breadcrumb items={crumbs} />

        {
            wide ? (
                <header class="pg-hero">
                    <h1 class="pg-h1">{d.heading}</h1>
                    {d.description && <p class="pg-lede">{d.description}</p>}
                    <div class="pg-hero-cta">
                        <a
                            class="btn btn-primary"
                            href={wa}
                            rel="noopener noreferrer"
                            target="_blank"
                        >
                            Get a Quick Quote
                        </a>
                        <a class="btn btn-ghost" href="/products/">
                            Browse Products
                        </a>
                    </div>
                </header>
            ) : (
                <header class="head col">
                    <h1>{d.heading}</h1>
                    {d.description && <p class="lede">{d.description}</p>}
                </header>
            )
        }

        {/* 联系页路由模板在这里注入询盘表单（hero 与正文之间） */}
        <slot />

        <div
            class={wide ? "body qf-article-body" : "body qf-article-body col"}
            set:html={html}
        />

        {
            d.faq?.length && (
                <div class={wide ? "faq-wrap" : "col"}>
                    <Faq items={d.faq} />
                </div>
            )
        }

        {/* 公司页与联系页是转化位，统一补一条 WhatsApp 出口 */}
        {
            !afterBody && (
                <aside class={wide ? "strip" : "strip col"}>
                    <p class="strip-title">Talk to the factory directly</p>
                    <a
                        class="btn btn-wa"
                        href={wa}
                        rel="noopener noreferrer"
                        target="_blank"
                    >
                        WhatsApp {siteConfig.whatsapp.display}
                    </a>
                </aside>
            )
        }
    </div>
</BaseLayout>

<style>
    .page {
        padding-top: 0.75rem;
    }

    /* 阅读列：与文章页 .post 同宽，标题/正文/卡片左边缘对齐；宽版模式不用它 */
    .col {
        max-width: 76ch;
    }

    /* 宽版模式的 FAQ 区限宽：通栏手风琴在 1400 容器里行太长 */
    .faq-wrap {
        max-width: 880px;
    }

    .head {
        margin: 1rem 0 1.75rem;
    }

    h1 {
        font-size: clamp(1.75rem, 1.35rem + 1.8vw, 2.4rem);
        margin: 0 0 0.6rem;
    }

    .lede {
        font-size: 1.02rem;
        color: var(--color-muted);
        max-width: 70ch;
        margin: 0;
    }

    /* 迁移层的居中与内垫已由 article.css 统一归零，限宽交给 .col */
    .body :global(table) {
        display: block;
        overflow-x: auto;
        max-width: 100%;
    }

    .strip {
        margin: 2.5rem 0 0;
        padding: 1.2rem 1.35rem;
        border: 1px solid var(--color-line);
        border-left: 4px solid var(--color-brand);
        border-radius: var(--radius);
        background: var(--color-brand-tint);
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: center;
        justify-content: space-between;
    }

    .strip-title {
        font-family: var(--font-display);
        font-weight: 700;
        color: var(--color-ink);
        margin: 0;
    }
</style>
