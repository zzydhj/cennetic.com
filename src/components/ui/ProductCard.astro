---
/**
 * 产品卡片。用于 /shop/、/products/、分类页与首页畅销区。
 *
 * 版式对齐参考站卡片体系：图片区 + 分类胶囊(非大写、浅底) + 两行标题 +
 * 底部动作条(左“查看规格”文字链 / 右“获取报价”绿胶囊)。整卡 hover 上浮 + 图片缩放。
 * 产品图多为正方形，图片区用 4/3 + contain，保证机身与图上参数文字不被裁掉。
 */
import type { Product } from "@lib/catalog.ts";
import { siteConfig } from "@lib/catalog.ts";
import { waLink } from "@lib/whatsapp.ts";

interface Props {
    product: Product;
    /** 首屏 LCP 卡片可提前加载 */
    eager?: boolean;
}

const { product, eager = false } = Astro.props;
const cover = product.images[0];
const category = product.categories[0]?.name;

const wa = waLink(
    { number: siteConfig.whatsapp.number, siteUrl: siteConfig.url },
    {
        subject: `${product.name} (${siteConfig.url}${product.canonical})`,
    },
);
---

<article class="card prod">
    <a class="thumb" href={product.canonical} tabindex="-1" aria-hidden="true">
        {
            cover ? (
                <img
                    src={cover.src}
                    alt=""
                    width={cover.width}
                    height={cover.height}
                    loading={eager ? "eager" : "lazy"}
                    decoding="async"
                />
            ) : (
                <span class="noimg">CENNETIC</span>
            )
        }
    </a>

    <div class="body">
        {category && <span class="cat">{category}</span>}
        <h3 class="title"><a href={product.canonical}>{product.name}</a></h3>
        <p class="foot">
            <a class="spec" href={product.canonical}>View specs →</a>
            <a class="quote" href={wa} rel="noopener noreferrer" target="_blank"
                >Get a quote</a
            >
        </p>
    </div>
</article>

<style>
    .prod {
        display: flex;
        flex-direction: column;
        height: 100%;
    }
    .prod:hover {
        border-color: var(--color-accent);
    }

    .thumb {
        display: block;
        flex: 0 0 auto;
        aspect-ratio: 4 / 3;
        background: var(--color-surface);
        overflow: hidden;
    }
    .thumb img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
        transition: transform 0.35s var(--ease);
    }
    .prod:hover .thumb img {
        transform: scale(1.05);
    }
    .noimg {
        display: grid;
        place-items: center;
        height: 100%;
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 1.1rem;
        letter-spacing: 0.08em;
        color: var(--color-line);
    }

    .body {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1rem 1.1rem 1.1rem;
        flex: 1 1 auto;
        min-width: 0;
    }

    /* 分类：浅底胶囊，非大写 */
    .cat {
        align-self: flex-start;
        background: var(--color-brand-soft);
        color: var(--color-brand-deep);
        border-radius: var(--radius-pill);
        padding: 0.16rem 0.6rem;
        font-size: 0.72rem;
        font-weight: 600;
        line-height: 1.5;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .title {
        font-size: 1.02rem;
        line-height: 1.4;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .title a {
        color: var(--color-ink);
    }
    .title a:hover {
        color: var(--color-brand);
    }

    .foot {
        margin: auto 0 0;
        padding-top: 0.8rem;
        border-top: 1px solid var(--color-line-soft);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
    }
    .spec {
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--color-muted);
        white-space: nowrap;
    }
    .spec:hover {
        color: var(--color-brand);
    }
    .quote {
        display: inline-flex;
        align-items: center;
        background: var(--color-good);
        color: #fff;
        border-radius: var(--radius-pill);
        padding: 0.4rem 0.9rem;
        font-family: var(--font-display);
        font-size: 0.78rem;
        font-weight: 700;
        white-space: nowrap;
        transition:
            background-color var(--dur) var(--ease),
            transform var(--dur) var(--ease),
            box-shadow var(--dur) var(--ease);
    }
    .quote:hover {
        background: #166a2e;
        color: #fff;
        transform: translateY(-1px);
        box-shadow: var(--shadow-sm);
    }
</style>
