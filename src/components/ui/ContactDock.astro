---
/**
 * 右下角常驻联系浮窗：WhatsApp + Tawk.to。
 *
 * 表单已按需求整体移除，这里承担全部转化入口，所以它必须始终可达。
 *
 * Tawk.to 的关键处理：**不在首屏加载**。它的官方片段会同步注入一个第三方 script，
 * 直接放上来会把 LCP 与 TBT 拖穿，与「顶级 SEO」目标正面冲突。
 * 这里改为「先让 WhatsApp 可见可用，Tawk 等浏览器空闲再注入」，
 * 并留出 site.json 未填 ID 时完全不加载的路径（现在就是未填状态）。
 */
import { siteConfig } from '@lib/catalog.ts';
import { waLink } from '@lib/whatsapp.ts';

const wa = waLink({ number: siteConfig.whatsapp.number, siteUrl: siteConfig.url }, {
    text: 'Hi Cennetic, I have a CNC machine enquiry.',
});

const tawkConfigured = Boolean(siteConfig.tawk.propertyId && siteConfig.tawk.widgetId);
---

<div class="contact-dock">
    <a class="dock wa" href={wa} rel="noopener noreferrer" target="_blank" aria-label="Chat on WhatsApp">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15s-.77.96-.94 1.16c-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.07-.13-.27-.2-.57-.35M12.05 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.38 9.38 0 0 1 14.6-11.6 9.31 9.31 0 0 1 2.75 6.63 9.38 9.38 0 0 1-9.11 9.38M20.52 3.45A11.8 11.8 0 0 0 12.05 0C5.46 0 .1 5.36.1 11.95c0 2.1.55 4.15 1.6 5.96L0 24l6.24-1.64a11.9 11.9 0 0 0 5.8 1.48h.01c6.58 0 11.94-5.36 11.95-11.95a11.9 11.9 0 0 0-3.48-8.44"/>
        </svg>
        <span>WhatsApp</span>
    </a>

    {tawkConfigured && (
        <button type="button" class="dock tawk" id="tawk-open" aria-label="Live chat">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2M7 11H5V9h2zm5 0h-2V9h2zm5 0h-2V9h2z"/>
            </svg>
            <span>Live Chat</span>
        </button>
    )}
</div>

{tawkConfigured && (
    <script
        define:vars={{ propertyId: siteConfig.tawk.propertyId, widgetId: siteConfig.tawk.widgetId }}
    >
        // 空闲注入：不抢首屏带宽与主线程，被 LCP 之后才加载
        const load = () => {
            window.Tawk_API = window.Tawk_API || {};
            window.Tawk_LoadStart = new Date();
            const s = document.createElement('script');
            s.async = true;
            s.src = `https://embed.tawk.to/${propertyId}/${widgetId}`;
            s.charset = 'UTF-8';
            s.crossOrigin = 'anonymous';
            document.head.appendChild(s);
        };
        // requestIdleCallback 并非所有浏览器都有；不支持时退到定时器等价时机
        if ('requestIdleCallback' in window) {
            requestIdleCallback(load, { timeout: 4000 });
        } else {
            setTimeout(load, 2500);
        }
        document.getElementById('tawk-open')?.addEventListener('click', () => {
            if (window.Tawk_API?.maximize) window.Tawk_API.maximize();
        });
    </script>
)}

<style>
    .contact-dock {
        position: fixed;
        right: 1rem;
        bottom: 1rem;
        z-index: 60;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .dock {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.7rem 1rem;
        border: 0;
        border-radius: 999px;
        background: #25d366;
        color: #fff;
        font-family: var(--font-display);
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        box-shadow: var(--shadow-float);
    }

    .dock:hover { background: #1da851; color: #fff; }
    .tawk { background: var(--color-brand); }
    .tawk:hover { background: var(--color-brand-dark); }

    /* 移动端只留图标，避免遮住正文右下角 */
    @media (width <= 560px) {
        .dock span { display: none; }
        .dock { padding: 0.75rem; justify-content: center; }
    }
</style>
