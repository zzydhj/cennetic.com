---
/**
 * 规格表。
 *
 * 数据来自 WooCommerce 的产品属性（attributes/terms）。这里刻意用真正的 <table>
 * 而不是 div 网格：规格是二维数据，表格才能被屏幕阅读器正确朗读，
 * 也才能被 Google 识别成产品参数。表头带 scope 由迁移阶段补过，此处同理。
 */
interface Props {
    rows: Array<{ name: string; values: string[] }>;
    name: string;
}

const { rows, name } = Astro.props;
---

{
    rows.length > 0 && (
        <section class="specs" aria-labelledby="specs-h">
            <h2 id="specs-h">{name} specifications</h2>
            <div class="scroll">
                <table>
                    <caption class="sr">
                        Technical specifications for {name}.
                    </caption>
                    <thead>
                        <tr>
                            <th scope="col">Parameter</th>
                            <th scope="col">Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        {rows.map((r) => (
                            <tr>
                                <th scope="row">{r.name}</th>
                                <td>{r.values.join(" / ")}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>
    )
}

<style>
    .specs {
        margin-top: 3rem;
        padding-top: 1.75rem;
        border-top: 1px solid var(--color-line);
    }

    h2 {
        font-size: 1.3rem;
        margin: 0 0 1rem;
    }

    /* 窄屏横向滚动，而不是让长参数把版面撑破 */
    .scroll {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
    }

    .sr {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
        border: 0;
    }

    th,
    td {
        text-align: left;
        padding: 0.7rem 0.9rem;
        border-bottom: 1px solid var(--color-line-soft);
    }

    thead th {
        background: var(--color-surface);
        font-family: var(--font-display);
        font-size: 0.8rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--color-muted);
    }

    tbody th[scope="row"] {
        font-weight: 600;
        color: var(--color-ink);
    }
</style>
