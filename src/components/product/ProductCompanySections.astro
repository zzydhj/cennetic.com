---
/**
 * 产品详情页 · 公司通版内容区(单一事实源,固化在代码里)。
 *
 * 运营在后台只能编辑「产品参数」(specs / body / summary / images);
 * 这一段与具体型号无关的工厂自我介绍不属于任何 products.body,而是构建时
 * 渲染进每个产品页的共享组件 —— 一处维护、DB 不膨胀、零运行时。
 *
 * 版式按迁移源站(qfcncmachine.com,即 CENNETIC 品牌升级前的原站)产品页
 * 「Full Specifications」以下的真实设计 1:1 复刻:背景图横幅 + 深色分组标题条 +
 * 图左文右/上图下文混合卡片 + 车间大图带字幕 + 居中检测协议 + Bento 客户墙 + 红色 CTA。
 * 品牌一律改挂 CENNETIC(用本站 --color-brand,不残留乔锋红/号码/链接)。
 */
import { siteConfig } from "@lib/catalog.ts";
import { waLink } from "@lib/whatsapp.ts";

const { productName } = Astro.props as { productName: string };

const img = (name: string) => `/images/site/company/${name}`;
const quote = waLink(
    { number: siteConfig.whatsapp.number, siteUrl: siteConfig.url },
    {
        subject: `${productName} — factory quote (${siteConfig.url}/contact-us/)`,
    },
);
const tour = waLink(
    { number: siteConfig.whatsapp.number, siteUrl: siteConfig.url },
    { subject: `Virtual factory tour request (${siteConfig.url})` },
);

// WHY PARTNER —— 五条承诺(标题 + 括注)
const promises: Array<[string, string]> = [
    [
        "Turnkey Machining Solutions",
        "Covering VMC, HMC, 5-Axis, CNC Lathes & Grinding Machines",
    ],
    [
        "Rigorous Quality Control",
        "100% Laser Interferometer & Ballbar tested before delivery + Full QC Reports",
    ],
    [
        "Global Engineering Support",
        "Overseas installation, training, and fast spare parts dispatch",
    ],
    [
        "24/7 Expert Technical Assistance",
        "Direct support from experienced mechanical engineers, not just sales",
    ],
    [
        "Flexible OEM/ODM Customization",
        "Tailored machine configurations, sheet metal design & brand identity",
    ],
];
type Badge = { kind: "ce" | "shield" | "factory"; label: string };
const badges: Badge[] = [
    { kind: "ce", label: "CE / ISO 9001" },
    { kind: "shield", label: "15+ Years Experience" },
    { kind: "factory", label: "Factory Direct" },
];

// 产品系列 —— 4 组。h = 两列横向卡(图左文右);v = 三列竖向卡(上图下文)
interface Card {
    img: string;
    title: string;
    best: string;
    points: string[];
}
interface Group {
    title: string;
    layout: "h" | "v";
    cards: Card[];
}
const groups: Group[] = [
    {
        title: "CNC Machining Centers (Milling Solutions)",
        layout: "h",
        cards: [
            {
                img: "vmc.webp",
                title: "VMC (Vertical Machining Center)",
                best: "Complex surfaces & high-precision parts.",
                points: [
                    "Flexible 3+2 axis configuration.",
                    "Vertical spindle for excellent cutting rigidity.",
                    "High-speed ATC (Automatic Tool Changer).",
                ],
            },
            {
                img: "hmc.webp",
                title: "HMC (Horizontal Machining Center)",
                best: "Box-type parts & mass production.",
                points: [
                    "Horizontal spindle design.",
                    "Outstanding chip evacuation performance.",
                    "Ideal for heavy-duty continuous cutting.",
                ],
            },
            {
                img: "gmc.webp",
                title: "GMC (Gantry Machining Center)",
                best: "Heavy & oversized workpieces.",
                points: [
                    "Ultra-large span bridge structure.",
                    "Exceptional stability and vibration absorption.",
                    "Perfect for aerospace and large mold industries.",
                ],
            },
            {
                img: "5axis.webp",
                title: "5-Axis Machining Center",
                best: "Arbitrary complex spatial surfaces.",
                points: [
                    "Ultimate precision and surface finish.",
                    "Complete multi-sided machining in a single setup.",
                    "Significantly reduces fixture costs and clamping errors.",
                ],
            },
        ],
    },
    {
        title: "CNC Lathes (Turning Solutions)",
        layout: "v",
        cards: [
            {
                img: "turn-mill.webp",
                title: "Turn-Mill Center",
                best: "Multi-process complex components.",
                points: [
                    "Integrates turning and milling capabilities.",
                    "One setup for complete machining.",
                    "Drastically reduces handling time and errors.",
                ],
            },
            {
                img: "gang-tool-lathe.webp",
                title: "Gang Tool Lathe",
                best: "Mass production of small/micro parts.",
                points: [
                    "Lightning-fast tool change mechanism.",
                    "Compact footprint saves factory space.",
                    "The ultimate profit-maker for high-volume orders.",
                ],
            },
            {
                img: "slant-bed-lathe.webp",
                title: "Slant Bed CNC Lathe",
                best: "Medium to large precision parts.",
                points: [
                    "45°/60° slant bed design.",
                    "Perfect chip flow and ergonomic access.",
                    "High structural rigidity for heavy cutting.",
                ],
            },
        ],
    },
    {
        title: "Precision Grinding & EDM Equipment",
        layout: "h",
        cards: [
            {
                img: "grinding.webp",
                title: "Milling & Grinding Machines",
                best: "High-precision surface treatments.",
                points: [
                    "Covers universal milling to precision grinding.",
                    "Ensures superior surface flatness and finish.",
                    "Stable hydraulic and spindle systems.",
                ],
            },
            {
                img: "edm.webp",
                title: "EDM & WEDM Series",
                best: "Ultra-hard materials & complex cavities.",
                points: [
                    "High-precision electrical discharge machining.",
                    "Perfect for precise contour cutting.",
                    "Low wire consumption and high efficiency.",
                ],
            },
        ],
    },
    {
        title: "Precision Measurement Equipment (Metrology Solutions)",
        layout: "v",
        cards: [
            {
                img: "vmm.webp",
                title: "Vision Measurement Machine (VMM)",
                best: "High-precision 2D/2.5D dimensional inspection.",
                points: [
                    "Advanced optical system for accurate non-contact measurement.",
                    "Automated edge detection and programmable lighting.",
                    "Ideal for flat parts, stamped components, and PCBs.",
                ],
            },
            {
                img: "instant-vision.webp",
                title: "Instant Vision Measuring System",
                best: "Rapid batch inspection of small and micro parts.",
                points: [
                    "One-shot measurement of multiple dimensions in seconds.",
                    "Double telecentric lens eliminates distortion and operator errors.",
                    "Significantly boosts QA efficiency for high-volume production.",
                ],
            },
            {
                img: "cmm.webp",
                title: "Coordinate Measuring Machine (CMM)",
                best: "Complex 3D spatial geometry and GD&T inspection.",
                points: [
                    "High-precision tactile probing for full 3D analysis.",
                    "Ultra-stable granite structure ensures measurement accuracy.",
                    "Perfect for aerospace, automotive, and precision mold parts.",
                ],
            },
        ],
    },
];

// 车间:3 张全幅大图(带字幕)+ 6 张细节图(两列)
const workshopBig = [
    {
        img: "vertical-machining-center-workshop.webp",
        cap: "Vertical Machining Center",
    },
    {
        img: "turret-milling-machine-workshop.webp",
        cap: "Turret Milling Machine",
    },
    { img: "machining-center-workshop.webp", cap: "Machining Center Workshop" },
];
const workshopGrid = Array.from({ length: 6 }, (_, i) => ({
    img: `workshop-detail-${i + 1}.webp`,
    alt: "Cennetic factory workshop",
}));

// 检测:主轴动平衡(3 图带字幕)+ 三轴激光校准(6 图)
const balance = [
    { img: "balance-point-detection.webp", cap: "Balance Point Detection" },
    {
        img: "precision-weight-calibration.webp",
        cap: "Precision Weight Calibration",
    },
    {
        img: "digital-waveform-verification.webp",
        cap: "Digital Waveform Verification",
    },
];
const laser = Array.from({ length: 6 }, (_, i) => ({
    img: `laser-calibration-${i + 1}.webp`,
    alt: "Laser interferometer calibration",
}));

// 全球合作:Bento(4 列,首图 2×2 大图,余下 1×1,含 3 条字幕)
const bento = [
    {
        img: "technical-discussion-1.webp",
        cap: "Technical discussion with European clients.",
        span: true,
    },
    { img: "client-visit.webp", cap: "" },
    { img: "client-visit-2.webp", cap: "" },
    {
        img: "machine-inspection.webp",
        cap: "On-site machine inspection & testing.",
    },
    { img: "client-visit-3.webp", cap: "" },
    { img: "client-visit-4.webp", cap: "" },
    { img: "client-visit-5.webp", cap: "" },
    {
        img: "strategic-cooperation.webp",
        cap: "Strategic cooperation agreement signing.",
        span: true,
    },
    { img: "client-visit-6.webp", cap: "" },
    { img: "client-visit-7.webp", cap: "" },
    { img: "client-visit8.webp", cap: "" },
];
---

<div class="company">
    <!-- ① 红色转化条 -->
    <section class="cta-strip">
        <div class="cta-txt">
            <h3>Ready to Upgrade Your Machining Capability?</h3>
            <p>
                Get a customized quote for the {productName} — our engineers respond
                within 24 hours.
            </p>
        </div>
        <a
            class="btn-white"
            href={quote}
            rel="noopener noreferrer"
            target="_blank">Request Factory Quote</a
        >
    </section>

    <!-- ② WHY PARTNER 横幅(背景图 + 深色渐变遮罩) -->
    <section class="banner">
        <div class="banner-overlay"></div>
        <div class="banner-content">
            <img
                class="banner-logo"
                src={siteConfig.logo}
                alt={siteConfig.name}
                width="241"
                height="32"
            />
            <h2 class="banner-title">
                Why Partner with Cennetic?<br />Your Trusted Source for<br
                />Precision Machining.
            </h2>
            <ul class="features">
                {
                    promises.map(([t, s]) => (
                        <li>
                            <svg
                                class="ck"
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                            >
                                <path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z" />
                            </svg>
                            <span class="ft">
                                <>
                                    <strong>{t}</strong>
                                    <span>{s}</span>
                                </>
                            </span>
                        </li>
                    ))
                }
            </ul>
            <div class="banner-bottom">
                <a class="btn-red" href="/contact-us/">Request Factory Quote</a>
                <ul class="trust">
                    {
                        badges.map((b) => (
                            <li class="badge">
                                {b.kind === "ce" ? (
                                    <span class="badge-ico ce">CE</span>
                                ) : b.kind === "shield" ? (
                                    <svg
                                        class="badge-ico"
                                        viewBox="0 0 24 24"
                                        aria-hidden="true"
                                    >
                                        <path d="M12 2 4 5v6c0 5 3.4 8.5 8 11 4.6-2.5 8-6 8-11V5z" />
                                    </svg>
                                ) : (
                                    <svg
                                        class="badge-ico"
                                        viewBox="0 0 24 24"
                                        aria-hidden="true"
                                    >
                                        <path d="M2 20h20v-2H2zm2-3V9l5 3V9l5 3V6h4v11z" />
                                    </svg>
                                )}
                                <span class="badge-txt">{b.label}</span>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </section>

    <!-- ③ 产品系列目录 -->
    <section class="catalog">
        {
            groups.map((g) => (
                <div class="group">
                    <h3 class="grp-title">{g.title}</h3>
                    <div
                        class:list={[
                            "cards",
                            g.layout === "h" ? "cols-2" : "cols-3",
                        ]}
                    >
                        {g.cards.map((c) => (
                            <article
                                class:list={[
                                    "card",
                                    g.layout === "h" ? "h" : "v",
                                ]}
                            >
                                <div class="card-img">
                                    <img
                                        src={img(c.img)}
                                        alt={c.title}
                                        loading="lazy"
                                        decoding="async"
                                    />
                                </div>
                                <div class="card-body">
                                    <h4>{c.title}</h4>
                                    <p class="best">
                                        <strong>Best for:</strong> {c.best}
                                    </p>
                                    <ul>
                                        {c.points.map((p) => (
                                            <li>{p}</li>
                                        ))}
                                    </ul>
                                </div>
                            </article>
                        ))}
                    </div>
                </div>
            ))
        }
    </section>

    <!-- ④ 车间:全幅大图带字幕 + 细节网格 -->
    <section class="block">
        <div class="blk-head">
            <p class="eyebrow">Inside the factory</p>
            <h2 class="big-title">Our Production Floor</h2>
        </div>
        <div class="wbig-stack">
            {
                workshopBig.map((w) => (
                    <figure class="wbig">
                        <img
                            src={img(w.img)}
                            alt={w.cap}
                            loading="lazy"
                            decoding="async"
                        />
                        <figcaption>{w.cap}</figcaption>
                    </figure>
                ))
            }
        </div>
        <div class="wgrid">
            {
                workshopGrid.map((w) => (
                    <div class="wcell">
                        <img
                            src={img(w.img)}
                            alt={w.alt}
                            loading="lazy"
                            decoding="async"
                        />
                    </div>
                ))
            }
        </div>
    </section>

    <!-- ⑤ 检测协议 -->
    <section class="block inspect">
        <h2 class="big-title">Rigorous Inspection Protocols</h2>
        <p class="big-sub">
            Data-Driven Precision. 100% Tested Before Delivery.
        </p>

        <h3 class="sec-title">Spindle Dynamic Balancing</h3>
        <p class="sec-desc">
            Every spindle undergoes a strict dynamic balancing process to
            eliminate micro-vibrations, ensuring flawless surface finishes and
            extending tool life during high-speed machining.
        </p>
        <div class="img-cards">
            {
                balance.map((b) => (
                    <figure class="img-card">
                        <div class="img-box">
                            <img
                                src={img(b.img)}
                                alt={b.cap}
                                loading="lazy"
                                decoding="async"
                            />
                        </div>
                        <figcaption>{b.cap}</figcaption>
                    </figure>
                ))
            }
        </div>

        <h3 class="sec-title center">3-Axis Laser Calibration</h3>
        <p class="red-line">100% Inspected. No Exceptions.</p>
        <p class="sec-desc center">
            We don't rely on random batch testing. Every machine is strictly
            calibrated using advanced laser interferometers to guarantee
            micro-level positioning accuracy and repeatability across the X, Y,
            and Z axes.
        </p>
        <div class="img-cards">
            {
                laser.map((l) => (
                    <div class="img-box">
                        <img
                            src={img(l.img)}
                            alt={l.alt}
                            loading="lazy"
                            decoding="async"
                        />
                    </div>
                ))
            }
        </div>
    </section>

    <!-- ⑥ 全球合作 Bento -->
    <section class="block partners">
        <div class="ph-head">
            <h2 class="ph-title">Global Partnerships</h2>
            <p class="ph-sub">
                Delivering high-precision CNC solutions to manufacturers across
                Europe, North America and Southeast Asia. We warmly welcome
                clients from all over the world to visit our manufacturing
                facility.
            </p>
        </div>
        <div class="bento">
            {
                bento.map((g) => (
                    <figure class:list={["bitem", g.span && "big"]}>
                        <img
                            src={img(g.img)}
                            alt={
                                g.cap || "Client visiting the Cennetic factory"
                            }
                            loading="lazy"
                            decoding="async"
                        />
                        {g.cap && <figcaption>{g.cap}</figcaption>}
                    </figure>
                ))
            }
        </div>
    </section>

    <!-- ⑦ 虚拟看厂 红色横幅 -->
    <section class="tour">
        <h2>Book a Virtual Factory Tour Today!</h2>
        <p>
            Can't visit in person? Let our engineers show you around via live
            video.
        </p>
        <a class="btn-white" href={tour} rel="noopener noreferrer" target="_blank">Arrange a Tour</a>
    </section>
</div>

<style>
    .company {
        margin-top: 3rem;
        display: grid;
        gap: clamp(2rem, 4vw, 3rem);
    }

    /* ── ① 红色转化条 ── */
    .cta-strip {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        background: var(--color-brand);
        border-radius: var(--radius-lg);
        padding: clamp(1.5rem, 3vw, 2.2rem) clamp(1.5rem, 3.5vw, 2.6rem);
        box-shadow: var(--shadow-card);
    }
    .cta-txt h3 {
        margin: 0 0 0.35rem;
        color: #fff;
        font-size: clamp(1.2rem, 1rem + 0.8vw, 1.6rem);
        font-weight: 800;
    }
    .cta-txt p {
        margin: 0;
        color: rgb(255 255 255 / 0.88);
        font-size: 0.98rem;
        max-width: 60ch;
    }
    .btn-white {
        background: #fff;
        color: var(--color-brand);
        font-weight: 800;
        font-size: 0.95rem;
        letter-spacing: 0.03em;
        padding: 0.95rem 1.9rem;
        border-radius: var(--radius-sm);
        white-space: nowrap;
        flex-shrink: 0;
    }
    .btn-white:hover {
        background: var(--color-brand-tint);
    }

    /* ── ② WHY 横幅 ── */
    .banner {
        position: relative;
        border-radius: var(--radius-lg);
        overflow: hidden;
        color: #fff;
        background: url("/images/site/company/cnc-working.webp") right center /
            cover no-repeat;
        background-color: var(--color-ink);
    }
    .banner-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to right,
            rgb(18 22 30 / 0.96) 0%,
            rgb(18 22 30 / 0.9) 55%,
            rgb(18 22 30 / 0.35) 100%
        );
    }
    .banner-content {
        position: relative;
        padding: clamp(2rem, 4vw, 3.2rem);
        max-width: 860px;
    }
    .banner-logo {
        height: 34px;
        width: auto;
        margin-bottom: 1.6rem;
        filter: brightness(0) invert(1);
    }
    .banner-title {
        margin: 0 0 1.8rem;
        font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.25rem);
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: 0.01em;
        text-transform: uppercase;
        color: #fff;
    }
    .features {
        list-style: none;
        margin: 0 0 2rem;
        padding: 0;
        display: grid;
        gap: 1.1rem;
    }
    .features li {
        display: flex;
        align-items: flex-start;
        gap: 0.9rem;
    }
    .ck {
        flex-shrink: 0;
        width: 24px;
        height: 24px;
        margin-top: 2px;
        fill: var(--color-brand-on-dark);
    }
    .ft {
        display: block;
    }
    .ft strong {
        display: block;
        font-size: 1.05rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 0.15rem;
    }
    .ft span {
        display: block;
        font-size: 0.9rem;
        color: rgb(255 255 255 / 0.72);
        line-height: 1.45;
    }
    .banner-bottom {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 2rem;
    }
    .btn-red {
        background: var(--color-brand);
        color: #fff;
        font-weight: 700;
        font-size: 0.98rem;
        padding: 0.95rem 1.9rem;
        border-radius: var(--radius-sm);
        box-shadow: var(--shadow-card);
    }
    .btn-red:hover {
        background: var(--color-brand-dark);
    }
    .trust {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 1.9rem;
    }
    .badge {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.35rem;
        text-align: center;
    }
    .badge-ico {
        width: 28px;
        height: 28px;
        fill: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .badge-ico.ce {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.35rem;
        color: #fff;
    }
    .badge-txt {
        font-size: 0.78rem;
        color: rgb(255 255 255 / 0.9);
        white-space: nowrap;
    }

    /* ── ③ 产品系列目录 ── */
    .catalog {
        background: var(--color-surface);
        border-radius: var(--radius-lg);
        padding: clamp(1.4rem, 3vw, 2.2rem);
    }
    .group + .group {
        margin-top: 2.4rem;
    }
    .grp-title {
        display: flex;
        align-items: center;
        margin: 0 0 1.2rem;
        padding: 0.85rem 1.3rem;
        background: var(--color-ink);
        color: #fff;
        font-family: var(--font-display);
        font-size: clamp(1.1rem, 1rem + 0.6vw, 1.5rem);
        font-weight: 800;
        line-height: 1.2;
        border-radius: var(--radius);
    }
    .grp-title::before {
        content: "";
        display: inline-block;
        width: 6px;
        height: 1.5em;
        background: #fff;
        margin-right: 0.9rem;
        border-radius: 2px;
    }
    .cards {
        display: grid;
        gap: 1.25rem;
    }
    .cols-2 {
        grid-template-columns: repeat(2, 1fr);
    }
    .cols-3 {
        grid-template-columns: repeat(3, 1fr);
    }
    .card {
        display: flex;
        background: var(--color-paper);
        border: 0; /* 覆盖 global.css 同名 .card 的 1px 描边(此处要无描边卡) */
        border-radius: var(--radius-lg);
        padding: 1.5rem;
        box-shadow: var(--shadow-card);
    }
    .card.h {
        flex-direction: row;
        align-items: center;
        gap: 1.4rem;
    }
    .card.v {
        flex-direction: column;
        gap: 1rem;
    }
    .card-img {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .card.h .card-img {
        width: 38%;
    }
    .card.v .card-img {
        width: 100%;
        height: 190px;
    }
    .card.v .card-img img {
        max-height: 190px; /* 不超出图框,避免溢出到下方正文 */
    }
    .card-img img {
        max-width: 100%;
        max-height: 220px;
        width: auto;
        height: auto;
        object-fit: contain;
    }
