---
/**
 * 页面 <head> 的 SEO 输出。
 *
 * 逐条对齐源站 Rank Math 的产物：robots 值、自引用 canonical、og:*、twitter:*、
 * article:published_time / modified_time，再加 JSON-LD @graph。
 * 源站有的字段一个都不丢，源站没有的不凭空造（例如 hreflang —— 本站纯英文，加它是负收益）。
 */
import { siteConfig } from "@lib/catalog.ts";
import {
    buildJsonLd,
    formatTitle,
    absoluteUrl,
    type SeoInput,
} from "@lib/seo.ts";

export interface Props extends SeoInput {
    isHome?: boolean;
    /** noindex 页面不进 sitemap，由清单判定 */
    noindex?: boolean;
}

const {
    title,
    description,
    path,
    robots = "follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large",
    ogImage,
    ogImageWidth,
    ogImageHeight,
    type = "website",
    publishedTime,
    modifiedTime,
    authorName,
    breadcrumb,
    pageType = "page",
    product,
    faq,
    isHome = false,
    noindex = false,
} = Astro.props;

const fullTitle = formatTitle(title, isHome);
const canonical = absoluteUrl(path);
const image = ogImage ?? absoluteUrl(siteConfig.ogDefaultImage);
const jsonLd = buildJsonLd({
    title,
    description,
    path,
    ogImage: image,
    ogImageWidth,
    ogImageHeight,
    publishedTime,
    modifiedTime,
    authorName,
    breadcrumb,
    pageType,
    product,
    faq,
});

// 源站 noindex 的页面（如空分类）保持 noindex，同时不改变 URL 本身
const effectiveRobots = noindex ? "noindex, follow" : robots;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={effectiveRobots} />
<link rel="canonical" href={canonical} />

{/* ── Open Graph：与源站字段一一对应 ── */}
<meta property="og:locale" content="en_US" />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
{ogImageWidth && <meta property="og:image:width" content={ogImageWidth} />}
{ogImageHeight && <meta property="og:image:height" content={ogImageHeight} />}
<meta property="og:image:type" content="image/webp" />

{/* ── Twitter Card：源站输出 summary_large_image，保持一致 ── */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

{
    publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
    )
}
{
    modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
    )
}

{
    /* 不输出 meta name=generator：源站的 WordPress/WP Rocket/Elementor 签名属于
    不必要技术栈暴露，且对收录无任何作用 */
}

{/* JSON-LD 单块 @graph，组织/站点/页面/面包屑/正文实体互引 */}
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
