---
/**
 * 站点头部（对齐参考站框架：80px 吸顶、大写导航、Products 巨型菜单）。
 *
 * 巨型菜单为「左侧分类轨 + 右侧内容面板」结构：悬停/聚焦左轨切换右栏 pane，
 * 每个 pane 用缩略图卡片列出该分类下的具体机型 + 子分类文字链 + 底部“查看全部”。
 * 面板数据全部由 megaMenu() 从真实产品派生，后台加产品会自动长出新分类/机型。
 */
import { siteConfig, nav, megaMenu } from "@lib/catalog.ts";

const currentPath = (() => {
    const p = Astro.url.pathname;
    if (p === "/" || p === "") return "/";
    return p.endsWith("/") ? p : `${p}/`;
})();

function isActive(path: string): boolean {
    if (path === "/") return currentPath === "/";
    return currentPath === path || currentPath.startsWith(path);
}

const links = nav.primary.filter((l) => l.path !== "/");
const mega = megaMenu();
const wa = `https://wa.me/${siteConfig.whatsapp.number}`;

/** 把子分类树拍平成文字链（含各级），供 pane 里的“子分类”区 */
function flatten(
    nodes: { name: string; path: string; count: number; children: any[] }[],
): { name: string; path: string; count: number }[] {
    return nodes.flatMap((n) => [
        { name: n.name, path: n.path, count: n.count },
        ...flatten(n.children),
    ]);
}
---

<header class="site-header">
    <div class="shell bar">
        <a class="brand" href="/" aria-label={`${siteConfig.name} home`}>
            <img
                class="brand-logo"
                src={siteConfig.logo}
                alt={siteConfig.name}
                width="241"
                height="32"
                loading="eager"
                decoding="async"
            />
        </a>

        <nav id="site-nav" class="nav" aria-label="Main navigation">
            <a href="/" class={isActive("/") ? "on" : ""}>Home</a>
            {
                links.map((l) =>
                    l.path === "/products/" && mega.length > 0 ? (
                        <div class="mega">
                            <a
                                href={l.path}
                                class={isActive(l.path) ? "on" : ""}
                            >
                                {l.label}
                                <svg
                                    class="chev"
                                    width="11"
                                    height="7"
                                    viewBox="0 0 11 7"
                                    aria-hidden="true"
                                >
                                    <path
                                        d="M1 1l4.5 4.5L10 1"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.6"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                </svg>
                            </a>
                            <div class="mega-panel">
                                <div class="mega-card">
                                    <div class="mega-side">
                                        <p class="mega-side-head">Categories</p>
                                        {mega.map((col, i) => (
                                            <button
                                                type="button"
                                                class:list={[
                                                    "mega-tab",
                                                    i === 0 && "active",
                                                ]}
                                                data-mega-tab={String(i)}
                                            >
                                                <span class="mega-tab-name">
                                                    {col.name}
                                                </span>
                                                <span class="mega-count">
                                                    {col.count}
                                                </span>
                                            </button>
                                        ))}
                                        <div class="mega-side-foot">
                                            <a
                                                class="mega-browse"
                                                href="/products/"
                                            >
                                                Browse full catalogue →
                                            </a>
                                            <a
                                                class="btn btn-accent btn-sm mega-sample"
                                                href={wa}
                                                rel="noopener"
                                            >
                                                Get a quote
                                            </a>
                                        </div>
                                    </div>
                                    <div class="mega-main">
                                        {mega.map((col, i) => {
                                            const subs = flatten(col.children);
                                            return (
                                                <div
                                                    class:list={[
                                                        "mega-pane",
                                                        i === 0 && "active",
                                                    ]}
                                                    data-mega-pane={String(i)}
                                                >
                                                    <p class="mega-sec-title">
                                                        Models
                                                    </p>
                                                    <div class="mega-cards">
                                                        {col.models.map((m) => (
                                                            <a
                                                                class="mega-tcard"
                                                                href={m.path}
                                                                title={m.name}
                                                            >
                                                                <span class="mega-tcard-thumb">
                                                                    <img
                                                                        src={
                                                                            m.thumb
                                                                        }
                                                                        alt=""
                                                                        width="300"
                                                                        height="200"
                                                                        loading="eager"
                                                                        decoding="async"
                                                                    />
                                                                </span>
                                                                <span class="mega-tcard-label">
                                                                    {m.label}
                                                                </span>
                                                            </a>
                                                        ))}
                                                    </div>
                                                    {subs.length > 0 && (
                                                        <>
                                                            <p class="mega-sec-title">
                                                                Browse by type
                                                            </p>
                                                            <div class="mega-links">
                                                                {subs.map(
                                                                    (s) => (
                                                                        <a
                                                                            class="mega-link"
                                                                            href={
                                                                                s.path
                                                                            }
                                                                        >
                                                                            <span>
                                                                                {
                                                                                    s.name
                                                                                }
                                                                            </span>
                                                                            <span class="mega-link-count">
                                                                                {
                                                                                    s.count
                                                                                }
                                                                            </span>
                                                                        </a>
                                                                    ),
                                                                )}
                                                            </div>
                                                        </>
                                                    )}
                                                    <div class="mega-foot">
                                                        <a
                                                            class="mega-viewall"
                                                            href={col.path}
                                                        >
                                                            View all {col.name}{" "}
                                                            →
                                                        </a>
                                                        <span class="mega-foot-note">
                                                            <strong>
                                                                Factory-direct
                                                            </strong>
                                                            ISO-grade build,
                                                            export warranty
                                                            &amp; remote
                                                            support.
                                                        </span>
                                                    </div>
                                                </div>
                                            );
                                        })}
                                    </div>
                                </div>
                            </div>
                        </div>
                    ) : (
                        <a href={l.path} class={isActive(l.path) ? "on" : ""}>
                            {l.label}
                        </a>
                    ),
                )
            }
        </nav>

        <!-- 主转化入口：不放进 .nav，才能既紧跟导航又钉在右边缘（移动端抽屉里不重复出现） -->
        <a
            class="btn btn-primary cta"
            href={wa}
            rel="noopener"
            aria-label="WhatsApp"
        >
            <svg
                class="cta-ic"
                viewBox="0 0 24 24"
                width="17"
                height="17"
                fill="currentColor"
                aria-hidden="true"
                focusable="false"
            >
                <path
                    d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15s-.77.96-.94 1.16c-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.07-.13-.27-.2-.57-.35M12.05 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.38 9.38 0 0 1 14.6-11.6 9.31 9.31 0 0 1 2.75 6.63 9.38 9.38 0 0 1-9.11 9.38M20.52 3.45A11.8 11.8 0 0 0 12.05 0C5.46 0 .1 5.36.1 11.95c0 2.1.55 4.15 1.6 5.96L0 24l6.24-1.64a11.9 11.9 0 0 0 5.8 1.48h.01c6.58 0 11.94-5.36 11.95-11.95a11.9 11.9 0 0 0-3.48-8.44"
                ></path>
            </svg>
            <span class="cta-label">WhatsApp</span>
        </a>

        <button
            class="toggle"
            type="button"
            aria-expanded="false"
            aria-controls="site-nav"
        >
            <span class="sr-only">Menu</span>
            <span aria-hidden="true"></span>
        </button>
    </div>
</header>

<script>
    // 巨型菜单：悬停/聚焦左轨切换右栏 pane
    const tabs = Array.from(
        document.querySelectorAll<HTMLElement>("[data-mega-tab]"),
    );
    const panes = Array.from(
        document.querySelectorAll<HTMLElement>("[data-mega-pane]"),
    );
    function activate(id: string) {
        for (const t of tabs)
            t.classList.toggle("active", t.dataset.megaTab === id);
        for (const p of panes)
            p.classList.toggle("active", p.dataset.megaPane === id);
    }
    for (const t of tabs) {
        const id = t.dataset.megaTab!;
        t.addEventListener("mouseenter", () => activate(id));
        t.addEventListener("focus", () => activate(id));
        t.addEventListener("click", () => activate(id));
    }

    // 移动端抽屉
    const btn = document.querySelector<HTMLButtonElement>(
        ".site-header .toggle",
    );
    const navEl = document.getElementById("site-nav");
    if (btn && navEl) {
        btn.addEventListener("click", () => {
            const open = btn.getAttribute("aria-expanded") === "true";
            btn.setAttribute("aria-expanded", String(!open));
            navEl.classList.toggle("open");
        });
    }

    // 滚动给页眉加一层淡阴影
    const header = document.querySelector<HTMLElement>(".site-header");
    if (header) {
        const onScroll = () =>
            header.classList.toggle("scrolled", window.scrollY > 8);
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
    }
</script>

<style>
    .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: var(--color-paper);
        border-bottom: 1px solid var(--color-line);
        transition: box-shadow var(--dur) var(--ease);
    }
    .site-header.scrolled {
        box-shadow: 0 2px 12px rgb(15 32 56 / 0.08);
    }

    .bar {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        min-height: var(--header-h);
    }

    .brand {
        display: flex;
        align-items: center;
        flex-shrink: 0;
    }
    .brand-logo {
        display: block;
        /* 2rem = logo 自然高度 32px，按 1:1 渲染最锐利；占 80px 页眉的 40% */
        height: 2rem;
        width: auto;
    }

    .nav {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        /* 菜单紧跟 logo 靠左成一组，剩余空间交给 .cta 的 margin-inline-start:auto */
        margin-inline-start: clamp(1.75rem, 3vw, 3.25rem);
        /* 撑满页眉高度：让 .mega(align-self:stretch) 底边对齐到页眉底部，
           正好接住 absolute 面板的 top:100%(面板包含块是 sticky 的 .site-header)，
           消除「Products 与 Mega 之间那段空隙导致 hover 丢失」的问题。
           导航项仍靠 align-items:center 垂直居中，视觉不变。 */
        align-self: stretch;
    }

    /* 导航项：大写、粗、中间生长下划线（0.95rem 在 80px 页眉里才撑得住） */
    .nav a {
        position: relative;
        display: inline-flex;
        align-items: center;
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        color: var(--color-ink);
        padding: 0.5rem 0;
        border: none;
        white-space: nowrap;
    }
    .nav a::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -2px;
        height: 2px;
        background: var(--color-brand);
        transform: scaleX(0);
        transform-origin: center;
        transition: transform 0.25s var(--ease);
    }
    .nav a:hover::after,
    .nav a.on::after {
        transform: scaleX(1);
    }
    .nav a:hover,
    .nav a.on {
        color: var(--color-brand);
    }
    /* WhatsApp 主 CTA：钉在右边缘；高 40px，比 32px 的 logo 更重一档，主次分明 */
    .site-header a.cta {
        margin-inline-start: auto;
        flex-shrink: 0;
        gap: 0.45rem;
        padding: 0.7rem 1.25rem;
        font-size: 0.95rem;
        color: #fff;
    }
    .site-header a.cta:hover {
        color: #fff;
    }
    .cta-ic {
        flex-shrink: 0;
    }

    /* 窄屏：logo 缩一档、CTA 退成图标方钮，保证 logo+按钮+汉堡三者不挤 */
    @media (width <= 40rem) {
        .bar {
            gap: 0.9rem;
        }
        .brand-logo {
            height: 1.6rem;
        }
        .site-header a.cta {
            padding: 0.62rem 0.68rem;
        }
        .cta-label {
            display: none;
        }
    }
    @media (width <= 22rem) {
        .bar {
            gap: 0.7rem;
        }
        .brand-logo {
            height: 1.35rem;
        }
    }
    .chev {
        margin-left: 0.45rem;
        transition: transform 0.25s var(--ease);
    }
    .mega:hover .chev,
    .mega:focus-within .chev {
        transform: rotate(180deg);
    }

    /* ── Mega Menu（仅桌面）── */
    .mega {
        align-self: stretch;
        display: flex;
        align-items: center;
    }
    .mega-panel {
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%) translateY(8px);
        width: min(var(--container-max), calc(100% - 2rem));
        padding-top: 0.5rem;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition:
            opacity 0.2s var(--ease),
            transform 0.2s var(--ease),
            visibility 0.2s;
        z-index: 60;
    }
    .mega:hover .mega-panel,
    .mega:focus-within .mega-panel {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateX(-50%) translateY(0);
    }
    .mega-card {
        display: grid;
        grid-template-columns: 268px minmax(0, 1fr);
        min-height: 420px;
        background: var(--color-paper);
        border: 1px solid var(--color-line);
        border-top: 3px solid var(--color-accent);
        border-radius: 0 0 var(--radius-lg) var(--radius-lg);
        box-shadow: var(--shadow-float);
        overflow: hidden;
    }
    /* 左轨 */
    .mega-side {
        display: flex;
        flex-direction: column;
        background: var(--color-brand-tint);
        border-right: 1px solid var(--color-line);
        padding: 1.1rem 0.8rem;
        overflow-y: auto;
    }
    .mega-side-head {
        padding: 0 0.75rem 0.6rem;
        font-family: var(--font-display);
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-faint);
    }
    .mega-tab {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        width: 100%;
        text-align: left;
        padding: 0.75rem;
        margin-bottom: 0.15rem;
        border: none;
        border-left: 3px solid transparent;
        border-radius: var(--radius-sm);
        background: transparent;
        font-family: var(--font-display);
        font-size: 0.9rem;
        font-weight: 600;
        line-height: 1.3;
        color: var(--color-ink);
        cursor: pointer;
        transition:
            color var(--dur) var(--ease),
            background var(--dur) var(--ease),
            border-color var(--dur) var(--ease);
    }
    .mega-tab-name {
        min-width: 0;
    }
    .mega-tab:hover {
        color: var(--color-brand);
        background: var(--color-paper);
    }
    .mega-tab.active {
        color: var(--color-brand);
        background: var(--color-paper);
        border-left-color: var(--color-accent);
        box-shadow: var(--shadow-sm);
        /* 不改字重:加粗会使文字变宽、标题从一行变两行 → 切换时跳高。选中态靠竖条/底色/字色区分 */
    }
    .mega-tab .mega-count {
        margin-left: auto;
        background: var(--color-accent);
        color: #fff;
        font-size: 0.68rem;
        font-weight: 800;
        border-radius: var(--radius-pill);
        padding: 0.1rem 0.5rem;
    }
    .mega-side-foot {
        margin-top: auto;
        padding-top: 0.9rem;
        border-top: 1px solid var(--color-line);
        display: grid;
        gap: 0.55rem;
    }
    .mega .mega-browse {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--color-muted);
    }
    .mega .mega-browse:hover {
        color: var(--color-brand);
    }
    .mega-sample {
        justify-content: center;
    }
    /* 右栏 */
    .mega-main {
        display: grid;
        padding: 1.4rem 1.8rem;
        overflow-y: auto;
    }
    /* 所有 pane 叠在同一格(用 visibility 而非 display:none 隐藏),卡片高度自动
       取最高那个 pane → 切换 tab 不跳高,也不需写死像素。 */
    .mega-pane {
        grid-area: 1 / 1;
        display: flex;
        flex-direction: column;
        visibility: hidden;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.15s var(--ease);
    }
    .mega-pane.active {
        opacity: 1;
    }
    /* 只在面板展开(hover/focus-within)时才让 active pane 可见可点;
       收起时继承 .mega-pane 的 visibility:hidden,避免透明面板仍拦截页面点击。 */
    .mega:hover .mega-pane.active,
    .mega:focus-within .mega-pane.active {
        visibility: visible;
        pointer-events: auto;
    }
    .mega-sec-title {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        margin: 0 0 0.85rem;
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 800;
        letter-spacing: 0.01em;
        color: var(--color-ink);
    }
    .mega-sec-title::before {
        content: "";
        width: 4px;
        height: 16px;
        border-radius: 2px;
        background: var(--color-accent);
    }
    .mega-sec-title:not(:first-child) {
        margin-top: 1.3rem;
    }
    .mega-cards {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(148px, 1fr));
        gap: 0.8rem 0.9rem;
    }
    .mega .mega-tcard {
        display: flex;
        flex-direction: column;
        padding: 0;
        border: 1px solid var(--color-line);
        border-radius: 9px;
        overflow: hidden;
        background: var(--color-brand-tint);
        color: var(--color-ink);
        white-space: normal;
        transition:
            border-color var(--dur) var(--ease),
            box-shadow var(--dur) var(--ease),
            transform var(--dur) var(--ease);
    }
    .mega .mega-tcard:hover {
        border-color: var(--color-accent);
        box-shadow: var(--shadow);
        transform: translateY(-2px);
    }
    .mega-tcard-thumb {
        display: block;
        aspect-ratio: 3 / 2;
        overflow: hidden;
    }
    .mega-tcard-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s var(--ease);
    }
    .mega-tcard:hover .mega-tcard-thumb img {
        transform: scale(1.06);
    }
    .mega-tcard-label {
        padding: 0.5rem 0.6rem;
        font-family: var(--font-display);
        font-size: 0.82rem;
        font-weight: 700;
        text-align: center;
        color: var(--color-ink);
    }
    .mega-tcard:hover .mega-tcard-label {
        color: var(--color-brand);
    }
    .mega-links {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
        gap: 0.15rem 1rem;
    }
    .mega .mega-link {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.55rem;
        border-radius: 7px;
        font-size: 0.85rem;
        font-weight: 600;
        line-height: 1.35;
        color: var(--color-ink);
        white-space: normal;
    }
    .mega .mega-link::before {
        content: "";
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--color-accent-dark);
        opacity: 0.5;
        flex-shrink: 0;
    }
    .mega .mega-link:hover {
        background: var(--color-brand-soft);
    }
    .mega-link-count {
        margin-left: auto;
        font-size: 0.72rem;
        color: var(--color-faint);
    }
    .mega-foot {
        margin-top: auto;
        padding-top: 1rem;
        border-top: 1px solid var(--color-line);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        flex-wrap: wrap;
    }
    .mega .mega-viewall {
        padding: 0;
        border: none;
        border-bottom: 3px solid var(--color-accent);
        font-family: var(--font-display);
        font-size: 0.9rem;
        font-weight: 800;
        color: var(--color-ink);
        white-space: normal;
    }
    .mega .mega-viewall:hover {
        color: var(--color-brand);
        border-bottom-color: var(--color-brand);
    }
    .mega-foot-note {
        font-size: 0.8rem;
        line-height: 1.5;
        color: var(--color-muted);
    }
    .mega-foot-note strong {
        display: inline;
        margin-right: 0.4rem;
        color: var(--color-brand);
        font-weight: 700;
    }

    .toggle {
        display: none;
        width: 2.5rem;
        height: 2.5rem;
        border: 1px solid var(--color-line);
        border-radius: var(--radius-sm);
        background: transparent;
        cursor: pointer;
        position: relative;
    }
    .toggle span[aria-hidden] {
        position: absolute;
        inset: 50% 0.6rem auto 0.6rem;
        height: 2px;
