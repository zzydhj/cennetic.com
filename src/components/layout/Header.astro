---
/**
 * 站点头部。
 *
 * 源站这里加载了 WoodMart 的 headerBuilder / mobileNavigation / menuOffsets /
 * ajaxSearch / searchFullScreen 等 8 个 JS，还有 WooCommerce 购物车 fragment。
 * 纯静态 + 去购物车之后，这里只剩下一个真实需求：移动端展开/收起菜单。
 * 因此只保留一段几行的内联脚本，用原生 aria-expanded 控制。
 */
import { siteConfig, nav, megaMenu, megaFeatured } from "@lib/catalog.ts";
import MegaTree from "./MegaTree.astro";

// 统一成带尾斜杠的站内路径再比对，否则 /blog 与 /blog/ 会被当成两个不同页面
const currentPath = (() => {
    const p = Astro.url.pathname;
    if (p === "/" || p === "") return "/";
    return p.endsWith("/") ? p : `${p}/`;
})();

function isActive(path: string): boolean {
    if (path === "/") return currentPath === "/";
    return currentPath === path || currentPath.startsWith(path);
}

const links = nav.primary.filter((l) => l.path !== "/");
// 页眉 Products 的 Mega Menu 面板数据（按真实产品派生的分类树 + 精选机型）
const mega = megaMenu();
const featured = megaFeatured(3);
---

<header class="site-header">
    <div class="shell bar">
        <a class="brand" href="/" aria-label={`${siteConfig.name} home`}>
            {
                /*
              字标本身已含品牌名（CN + CENNETIC），所以不再另写文字标题；
              旧版这里是个红底“QF”字母块 + 文字，是 Qiaofeng 时代的残留。
              SVG 没写 width/height，必须给显式尺寸，否则首帧布局会跳（CLS）。
            */
            }
            <img
                class="brand-logo"
                src={siteConfig.logo}
                alt={siteConfig.name}
                width="241"
                height="32"
                loading="eager"
                decoding="async"
            />
        </a>

        <button
            class="toggle"
            type="button"
            aria-expanded="false"
            aria-controls="site-nav"
        >
            <span class="sr-only">Menu</span>
            <span aria-hidden="true"></span>
        </button>

        <nav id="site-nav" class="nav" aria-label="Main navigation">
            <a href="/" class={isActive("/") ? "on" : ""}>Home</a>
            {
                links.map((l) =>
                    l.path === "/products/" && mega.length > 0 ? (
                        <div class="mega">
                            <a
                                href={l.path}
                                class={isActive(l.path) ? "on" : ""}
                            >
                                {l.label}
                            </a>
                            <div class="mega-panel">
                                <div class="mega-card">
                                    <div class="mega-cols">
                                        {mega.map((col) => (
                                            <div class="mega-col">
                                                <a
                                                    class="mega-cat"
                                                    href={col.path}
                                                >
                                                    {col.thumb && (
                                                        <img
                                                            class="mega-cat-thumb"
                                                            src={col.thumb}
                                                            alt=""
                                                            width="46"
                                                            height="46"
                                                            loading="eager"
                                                            decoding="async"
                                                        />
                                                    )}
                                                    <span class="mega-cat-txt">
                                                        <span class="mega-cat-name">
                                                            {col.name}
                                                            <span class="mega-count">
                                                                {col.count}
                                                            </span>
                                                        </span>
                                                        {col.desc && (
                                                            <span class="mega-cat-desc">
                                                                {col.desc}
                                                            </span>
                                                        )}
                                                    </span>
                                                </a>
                                                {col.children.length > 0 && (
                                                    <MegaTree
                                                        nodes={col.children}
                                                    />
                                                )}
                                                <a
                                                    class="mega-seeall"
                                                    href={col.path}
                                                >
                                                    All {col.name} →
                                                </a>
                                            </div>
                                        ))}
                                    </div>
                                    <aside class="mega-rail">
                                        <p class="mega-rail-title">
                                            Featured models
                                        </p>
                                        {featured.map((f) => (
                                            <a class="mega-feat" href={f.path}>
                                                <img
                                                    src={f.thumb}
                                                    alt={f.name}
                                                    width="72"
                                                    height="72"
                                                    loading="eager"
                                                    decoding="async"
                                                />
                                                <span class="mega-feat-txt">
                                                    <span class="mega-feat-tag">
                                                        {f.tag}
                                                    </span>
                                                    <span class="mega-feat-name">
                                                        {f.name}
                                                    </span>
                                                </span>
                                            </a>
                                        ))}
                                        <a
                                            class="mega-cta"
                                            href={`https://wa.me/${siteConfig.whatsapp.number}`}
                                            rel="noopener"
                                        >
                                            Get a quote on WhatsApp →
                                        </a>
                                        <a class="mega-all" href="/products/">
                                            Browse all products →
                                        </a>
                                    </aside>
                                </div>
                            </div>
                        </div>
                    ) : (
                        <a href={l.path} class={isActive(l.path) ? "on" : ""}>
                            {l.label}
                        </a>
                    ),
                )
            }
            <a
                class="btn btn-wa btn-sm cta"
                href={`https://wa.me/${siteConfig.whatsapp.number}`}
                rel="noopener"
            >
                WhatsApp
            </a>
        </nav>
    </div>
</header>

<script>
    const btn = document.querySelector<HTMLButtonElement>(
        ".site-header .toggle",
    );
    const nav = document.getElementById("site-nav");
    if (btn && nav) {
        btn.addEventListener("click", () => {
            const open = btn.getAttribute("aria-expanded") === "true";
            btn.setAttribute("aria-expanded", String(!open));
            nav.classList.toggle("open");
        });
    }
</script>

<style>
    .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: var(--color-paper);
        border-bottom: 1px solid var(--color-line);
    }

    .bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        min-height: 4.25rem;
    }

    .brand {
        display: flex;
        align-items: center;
        flex-shrink: 0;
    }

    /* 字标宽高比约 7.5:1（viewBox 1485×197），只给高度即可自适应 */
    .brand-logo {
        display: block;
        height: 2rem;
        width: auto;
    }

    @media (max-width: 40rem) {
        .brand-logo {
            height: 1.6rem;
        }
    }

    .nav {
        display: flex;
        align-items: center;
        gap: 1.35rem;
    }

    .nav a {
        font-family: var(--font-display);
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--color-ink);
        padding: 0.35rem 0;
        border-bottom: 2px solid transparent;
        white-space: nowrap;
    }

    .nav a:hover {
        color: var(--color-brand);
    }
    .nav a.on {
        color: var(--color-brand);
        border-bottom-color: var(--color-brand);
    }

    .nav a.cta {
        color: #fff;
        border: none;
        margin-left: 0.35rem;
        padding: 0.55rem 1rem;
        border-radius: var(--radius-sm);
    }

    .nav a.cta:hover {
        color: #fff;
    }

    /* ── Mega Menu（仅桌面，悬停/键盘聚焦展开）── */
    .mega {
        align-self: stretch;
        display: flex;
        align-items: center;
    }
    .mega > a::after {
        content: "";
        display: inline-block;
        width: 0.32rem;
        height: 0.32rem;
        margin-left: 0.4rem;
        border-right: 2px solid currentColor;
        border-bottom: 2px solid currentColor;
        transform: rotate(45deg) translateY(-0.12rem);
        opacity: 0.55;
    }
    .mega-panel {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        padding: 0.6rem var(--spacing-page) 1.6rem;
        opacity: 0;
        visibility: hidden;
        transform: translateY(8px);
        transition:
            opacity 0.18s var(--ease),
            transform 0.18s var(--ease),
            visibility 0.18s;
        z-index: 60;
    }
    .mega:hover .mega-panel,
    .mega:focus-within .mega-panel {
        opacity: 1;
        visibility: visible;
        transform: none;
    }
    /* 透明悬停桥:覆盖触发项与面板之间的栏内空白,鼠标下移不丢 :hover */
    .mega-panel::before {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        top: -1.75rem;
        height: 1.75rem;
    }
    .mega-card {
        max-width: var(--container-max);
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 268px;
        gap: 1.8rem;
        background: var(--color-paper);
        border: 1px solid var(--color-line);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-float);
        padding: 1.6rem 1.8rem;
    }
    .mega-cols {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 1.4rem 2rem;
        align-content: start;
    }
    .mega .mega-cat {
        display: flex;
        align-items: flex-start;
        gap: 0.7rem;
        padding: 0 0 0.55rem;
        margin-bottom: 0.6rem;
        border: none;
        border-bottom: 1px solid var(--color-line);
        white-space: normal;
        color: var(--color-ink);
    }
    .mega-cat-thumb {
        flex-shrink: 0;
        width: 46px;
        height: 46px;
        object-fit: cover;
        border-radius: var(--radius-sm);
        background: var(--color-surface);
        border: 1px solid var(--color-line-soft);
    }
    .mega-cat-txt {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        min-width: 0;
    }
    .mega-cat-name {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.95rem;
        line-height: 1.25;
        white-space: normal;
    }
    .mega-cat-desc {
        font-family: var(--font-body);
        font-weight: 400;
        font-size: 0.78rem;
        line-height: 1.4;
        color: var(--color-muted);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .mega .mega-cat:hover .mega-cat-name {
        color: var(--color-brand);
    }
    .mega-count {
        flex-shrink: 0;
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--color-muted);
        background: var(--color-surface);
        border-radius: 999px;
        padding: 0.05rem 0.5rem;
    }
    /* 子分类树样式已随 MegaTree.astro 组件自带(作用域样式归属渲染组件);
       此处不再重复,否则因 cid 不同根本命不中。 */
    .mega .mega-seeall {
        display: inline-block;
        padding: 0;
        border: none;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 0.82rem;
        color: var(--color-brand);
    }
    .mega .mega-seeall:hover {
        color: var(--color-brand-dark);
        border: none;
    }
    /* 右侧栏：精选机型 + 快捷入口 */
    .mega-rail {
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
        border-left: 1px solid var(--color-line);
        padding-left: 1.6rem;
    }
    .mega-rail-title {
        margin: 0;
        font-family: var(--font-display);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-faint);
    }
    .mega .mega-feat {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        padding: 0.4rem;
        margin: 0 -0.4rem;
        border: none;
        border-radius: var(--radius);
        background: transparent;
        white-space: normal;
        color: var(--color-ink);
    }
    .mega .mega-feat:hover {
        background: var(--color-surface);
        border: none;
    }
    .mega-feat img {
        width: 56px;
        height: 56px;
        object-fit: cover;
        border-radius: var(--radius-sm);
        background: var(--color-paper);
        border: 1px solid var(--color-line-soft);
        flex-shrink: 0;
    }
    .mega-feat-txt {
        display: flex;
        flex-direction: column;
        gap: 0.12rem;
        min-width: 0;
    }
    .mega-feat-tag {
        font-size: 0.68rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--color-brand);
    }
    .mega-feat-name {
        font-family: var(--font-display);
        font-size: 0.82rem;
        font-weight: 600;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .mega .mega-cta {
        margin-top: 0.2rem;
        padding: 0.6rem 0.9rem;
        border: none;
        border-radius: var(--radius-sm);
        background: var(--color-brand);
        color: #fff;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 0.82rem;
        text-align: center;
    }
    .mega .mega-cta:hover {
        background: var(--color-brand-dark);
        color: #fff;
        border: none;
    }
    .mega .mega-all {
        padding: 0;
        border: none;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 0.82rem;
        color: var(--color-muted);
        text-align: center;
    }
    .mega .mega-all:hover {
        color: var(--color-brand);
        border: none;
    }

    .toggle {
        display: none;
        width: 2.5rem;
        height: 2.5rem;
        border: 1px solid var(--color-line);
        border-radius: var(--radius-sm);
        background: transparent;
        cursor: pointer;
        position: relative;
    }

    .toggle span[aria-hidden] {
        position: absolute;
        inset: 50% 0.6rem auto 0.6rem;
        height: 2px;
        background: var(--color-ink);
        box-shadow:
            0 -6px 0 var(--color-ink),
            0 6px 0 var(--color-ink);
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
        border: 0;
    }

    @media (width <= 960px) {
        .toggle {
            display: block;
        }

        /* 移动端不做 Mega：只保留 Products 链接，面板与箭头隐藏 */
        .mega {
            display: block;
            align-self: auto;
        }
        .mega > a::after {
            display: none;
        }
        .mega-panel {
            display: none;
        }

        .nav {
            position: absolute;
            inset: 100% 0 auto 0;
            flex-direction: column;
            align-items: stretch;
            gap: 0;
            background: var(--color-paper);
            border-bottom: 1px solid var(--color-line);
            padding: 0.5rem var(--spacing-page) 1rem;
            display: none;
        }

        .nav.open {
            display: flex;
        }

        .nav a {
            padding: 0.75rem 0;
            border-bottom: 1px solid var(--color-line-soft);
        }

        .nav a.on {
            border-bottom-color: var(--color-line-soft);
        }

        .nav a.cta {
            margin: 0.85rem 0 0;
            justify-content: center;
            border-bottom: none;
        }
    }
</style>
