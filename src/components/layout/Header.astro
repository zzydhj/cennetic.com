---
/**
 * 站点头部（对齐参考站框架：80px 吸顶、大写导航、Products 巨型菜单）。
 *
 * 巨型菜单为「左侧分类轨 + 右侧内容面板」结构：悬停/聚焦左轨切换右栏 pane，
 * 每个 pane 用缩略图卡片列出该分类下的具体机型 + 子分类文字链 + 底部“查看全部”。
 * 面板数据全部由 megaMenu() 从真实产品派生，后台加产品会自动长出新分类/机型。
 */
import { siteConfig, nav, megaMenu } from "@lib/catalog.ts";

const currentPath = (() => {
    const p = Astro.url.pathname;
    if (p === "/" || p === "") return "/";
    return p.endsWith("/") ? p : `${p}/`;
})();

function isActive(path: string): boolean {
    if (path === "/") return currentPath === "/";
    return currentPath === path || currentPath.startsWith(path);
}

const links = nav.primary.filter((l) => l.path !== "/");
const mega = megaMenu();
const wa = `https://wa.me/${siteConfig.whatsapp.number}`;

/** 把子分类树拍平成文字链（含各级），供 pane 里的“子分类”区 */
function flatten(
    nodes: { name: string; path: string; count: number; children: any[] }[],
): { name: string; path: string; count: number }[] {
    return nodes.flatMap((n) => [
        { name: n.name, path: n.path, count: n.count },
        ...flatten(n.children),
    ]);
}
---

<header class="site-header">
    <div class="shell bar">
        <a class="brand" href="/" aria-label={`${siteConfig.name} home`}>
            <img
                class="brand-logo"
                src={siteConfig.logo}
                alt={siteConfig.name}
                width="241"
                height="32"
                loading="eager"
                decoding="async"
            />
        </a>

        <button
            class="toggle"
            type="button"
            aria-expanded="false"
            aria-controls="site-nav"
        >
            <span class="sr-only">Menu</span>
            <span aria-hidden="true"></span>
        </button>

        <nav id="site-nav" class="nav" aria-label="Main navigation">
            <a href="/" class={isActive("/") ? "on" : ""}>Home</a>
            {
                links.map((l) =>
                    l.path === "/products/" && mega.length > 0 ? (
                        <div class="mega">
                            <a
                                href={l.path}
                                class={isActive(l.path) ? "on" : ""}
                            >
                                {l.label}
                                <svg
                                    class="chev"
                                    width="11"
                                    height="7"
                                    viewBox="0 0 11 7"
                                    aria-hidden="true"
                                >
                                    <path
                                        d="M1 1l4.5 4.5L10 1"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.6"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                </svg>
                            </a>
                            <div class="mega-panel">
                                <div class="mega-card">
                                    <div class="mega-side">
                                        <p class="mega-side-head">Categories</p>
                                        {mega.map((col, i) => (
                                            <button
                                                type="button"
                                                class:list={[
                                                    "mega-tab",
                                                    i === 0 && "active",
                                                ]}
                                                data-mega-tab={String(i)}
                                            >
                                                <span class="mega-tab-name">
                                                    {col.name}
                                                </span>
                                                <span class="mega-count">
                                                    {col.count}
                                                </span>
                                            </button>
                                        ))}
                                        <div class="mega-side-foot">
                                            <a
                                                class="mega-browse"
                                                href="/products/"
                                            >
                                                Browse full catalogue →
                                            </a>
                                            <a
                                                class="btn btn-accent btn-sm mega-sample"
                                                href={wa}
                                                rel="noopener"
                                            >
                                                Get a quote
                                            </a>
                                        </div>
                                    </div>
                                    <div class="mega-main">
                                        {mega.map((col, i) => {
                                            const subs = flatten(col.children);
                                            return (
                                                <div
                                                    class:list={[
                                                        "mega-pane",
                                                        i === 0 && "active",
                                                    ]}
                                                    data-mega-pane={String(i)}
                                                >
                                                    <p class="mega-sec-title">
                                                        Models
                                                    </p>
                                                    <div class="mega-cards">
                                                        {col.models.map((m) => (
                                                            <a
                                                                class="mega-tcard"
                                                                href={m.path}
                                                                title={m.name}
                                                            >
                                                                <span class="mega-tcard-thumb">
                                                                    <img
                                                                        src={
                                                                            m.thumb
                                                                        }
                                                                        alt=""
                                                                        width="300"
                                                                        height="200"
                                                                        loading="eager"
                                                                        decoding="async"
                                                                    />
                                                                </span>
                                                                <span class="mega-tcard-label">
                                                                    {m.label}
                                                                </span>
                                                            </a>
                                                        ))}
                                                    </div>
                                                    {subs.length > 0 && (
                                                        <>
                                                            <p class="mega-sec-title">
                                                                Browse by type
                                                            </p>
                                                            <div class="mega-links">
                                                                {subs.map(
                                                                    (s) => (
                                                                        <a
                                                                            class="mega-link"
                                                                            href={
                                                                                s.path
                                                                            }
                                                                        >
                                                                            <span>
                                                                                {
                                                                                    s.name
                                                                                }
                                                                            </span>
                                                                            <span class="mega-link-count">
                                                                                {
                                                                                    s.count
                                                                                }
                                                                            </span>
                                                                        </a>
                                                                    ),
                                                                )}
                                                            </div>
                                                        </>
                                                    )}
                                                    <div class="mega-foot">
                                                        <a
                                                            class="mega-viewall"
                                                            href={col.path}
                                                        >
                                                            View all {col.name}{" "}
                                                            →
                                                        </a>
                                                        <span class="mega-foot-note">
                                                            <strong>
                                                                Factory-direct
                                                            </strong>
                                                            ISO-grade build,
                                                            export warranty
                                                            &amp; remote
                                                            support.
                                                        </span>
                                                    </div>
                                                </div>
                                            );
                                        })}
                                    </div>
                                </div>
                            </div>
                        </div>
                    ) : (
                        <a href={l.path} class={isActive(l.path) ? "on" : ""}>
                            {l.label}
                        </a>
                    ),
                )
            }
            <a class="btn btn-primary btn-sm cta" href={wa} rel="noopener">
                WhatsApp
            </a>
        </nav>
    </div>
</header>

<script>
    // 巨型菜单：悬停/聚焦左轨切换右栏 pane
    const tabs = Array.from(
        document.querySelectorAll<HTMLElement>("[data-mega-tab]"),
    );
    const panes = Array.from(
        document.querySelectorAll<HTMLElement>("[data-mega-pane]"),
    );
    function activate(id: string) {
        for (const t of tabs)
            t.classList.toggle("active", t.dataset.megaTab === id);
        for (const p of panes)
            p.classList.toggle("active", p.dataset.megaPane === id);
    }
    for (const t of tabs) {
        const id = t.dataset.megaTab!;
        t.addEventListener("mouseenter", () => activate(id));
        t.addEventListener("focus", () => activate(id));
        t.addEventListener("click", () => activate(id));
    }

    // 移动端抽屉
    const btn = document.querySelector<HTMLButtonElement>(
        ".site-header .toggle",
    );
    const navEl = document.getElementById("site-nav");
    if (btn && navEl) {
        btn.addEventListener("click", () => {
            const open = btn.getAttribute("aria-expanded") === "true";
            btn.setAttribute("aria-expanded", String(!open));
            navEl.classList.toggle("open");
        });
    }

    // 滚动给页眉加一层淡阴影
    const header = document.querySelector<HTMLElement>(".site-header");
    if (header) {
        const onScroll = () =>
            header.classList.toggle("scrolled", window.scrollY > 8);
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
    }
</script>

<style>
    .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: var(--color-paper);
        border-bottom: 1px solid var(--color-line);
        transition: box-shadow var(--dur) var(--ease);
    }
    .site-header.scrolled {
        box-shadow: 0 2px 12px rgb(15 32 56 / 0.08);
    }

    .bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        min-height: var(--header-h);
    }

    .brand {
        display: flex;
        align-items: center;
        flex-shrink: 0;
    }
    .brand-logo {
        display: block;
        height: 2.35rem;
        width: auto;
    }
    @media (max-width: 40rem) {
        .brand-logo {
            height: 1.75rem;
        }
    }

    .nav {
        display: flex;
        align-items: center;
        gap: 1.15rem;
    }

    /* 导航项：大写、粗、中间生长下划线 */
    .nav a {
        position: relative;
        display: inline-flex;
        align-items: center;
        font-family: var(--font-display);
        font-size: 0.92rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        color: var(--color-ink);
        padding: 0.5rem 0;
        border: none;
        white-space: nowrap;
    }
    .nav a::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -2px;
        height: 2px;
        background: var(--color-brand);
        transform: scaleX(0);
        transform-origin: center;
        transition: transform 0.25s var(--ease);
    }
    .nav a:hover::after,
    .nav a.on::after {
        transform: scaleX(1);
    }
    .nav a:hover,
    .nav a.on {
        color: var(--color-brand);
    }
    .nav a.cta {
        color: #fff;
        margin-left: 0.25rem;
        padding: 0.6rem 1.15rem;
        text-transform: none;
        letter-spacing: normal;
    }
    .nav a.cta::after {
        display: none;
    }
    .nav a.cta:hover {
        color: #fff;
    }
    .chev {
        margin-left: 0.45rem;
        transition: transform 0.25s var(--ease);
    }
    .mega:hover .chev,
    .mega:focus-within .chev {
        transform: rotate(180deg);
    }

    /* ── Mega Menu（仅桌面）── */
    .mega {
        align-self: stretch;
        display: flex;
        align-items: center;
    }
    .mega-panel {
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%) translateY(8px);
        width: min(var(--container-max), calc(100% - 2rem));
        padding-top: 0.5rem;
        opacity: 0;
        visibility: hidden;
        transition:
            opacity 0.2s var(--ease),
            transform 0.2s var(--ease),
            visibility 0.2s;
        z-index: 60;
    }
    .mega:hover .mega-panel,
    .mega:focus-within .mega-panel {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(0);
    }
    .mega-card {
        display: grid;
        grid-template-columns: 268px minmax(0, 1fr);
        min-height: 420px;
        background: var(--color-paper);
        border: 1px solid var(--color-line);
        border-top: 3px solid var(--color-accent);
        border-radius: 0 0 var(--radius-lg) var(--radius-lg);
        box-shadow: var(--shadow-float);
        overflow: hidden;
    }
    /* 左轨 */
    .mega-side {
        display: flex;
        flex-direction: column;
        background: var(--color-brand-tint);
        border-right: 1px solid var(--color-line);
        padding: 1.1rem 0.8rem;
        overflow-y: auto;
    }
    .mega-side-head {
        padding: 0 0.75rem 0.6rem;
        font-family: var(--font-display);
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-faint);
    }
    .mega-tab {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        width: 100%;
        text-align: left;
        padding: 0.75rem;
        margin-bottom: 0.15rem;
        border: none;
        border-left: 3px solid transparent;
        border-radius: var(--radius-sm);
        background: transparent;
        font-family: var(--font-display);
        font-size: 0.9rem;
        font-weight: 600;
        line-height: 1.3;
        color: var(--color-ink);
        cursor: pointer;
        transition:
            color var(--dur) var(--ease),
            background var(--dur) var(--ease),
            border-color var(--dur) var(--ease);
    }
    .mega-tab-name {
        min-width: 0;
    }
    .mega-tab:hover {
        color: var(--color-brand);
        background: var(--color-paper);
    }
    .mega-tab.active {
        color: var(--color-brand);
        background: var(--color-paper);
        border-left-color: var(--color-accent);
        box-shadow: var(--shadow-sm);
        font-weight: 800;
    }
    .mega-tab .mega-count {
        margin-left: auto;
        background: var(--color-accent);
        color: #fff;
        font-size: 0.68rem;
        font-weight: 800;
        border-radius: var(--radius-pill);
        padding: 0.1rem 0.5rem;
    }
    .mega-side-foot {
        margin-top: auto;
        padding-top: 0.9rem;
        border-top: 1px solid var(--color-line);
        display: grid;
        gap: 0.55rem;
    }
    .mega .mega-browse {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--color-muted);
    }
    .mega .mega-browse:hover {
        color: var(--color-brand);
    }
    .mega-sample {
        justify-content: center;
    }
    /* 右栏 */
    .mega-main {
        padding: 1.4rem 1.8rem;
        overflow-y: auto;
    }
    .mega-pane {
        display: none;
        min-height: 100%;
    }
    .mega-pane.active {
        display: flex;
        flex-direction: column;
    }
    .mega-sec-title {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        margin: 0 0 0.85rem;
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 800;
        letter-spacing: 0.01em;
        color: var(--color-ink);
    }
    .mega-sec-title::before {
        content: "";
        width: 4px;
        height: 16px;
        border-radius: 2px;
        background: var(--color-accent);
    }
    .mega-sec-title:not(:first-child) {
        margin-top: 1.3rem;
    }
    .mega-cards {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(148px, 1fr));
        gap: 0.8rem 0.9rem;
    }
    .mega .mega-tcard {
        display: flex;
        flex-direction: column;
        padding: 0;
        border: 1px solid var(--color-line);
        border-radius: 9px;
        overflow: hidden;
        background: var(--color-brand-tint);
        color: var(--color-ink);
        white-space: normal;
        transition:
            border-color var(--dur) var(--ease),
            box-shadow var(--dur) var(--ease),
            transform var(--dur) var(--ease);
    }
    .mega .mega-tcard:hover {
        border-color: var(--color-accent);
        box-shadow: var(--shadow);
        transform: translateY(-2px);
    }
    .mega-tcard-thumb {
        display: block;
        aspect-ratio: 3 / 2;
        overflow: hidden;
    }
    .mega-tcard-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s var(--ease);
    }
    .mega-tcard:hover .mega-tcard-thumb img {
        transform: scale(1.06);
    }
    .mega-tcard-label {
        padding: 0.5rem 0.6rem;
        font-family: var(--font-display);
        font-size: 0.82rem;
        font-weight: 700;
        text-align: center;
        color: var(--color-ink);
    }
    .mega-tcard:hover .mega-tcard-label {
        color: var(--color-brand);
    }
    .mega-links {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
        gap: 0.15rem 1rem;
    }
    .mega .mega-link {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.55rem;
        border-radius: 7px;
        font-size: 0.85rem;
        font-weight: 600;
        line-height: 1.35;
        color: var(--color-ink);
        white-space: normal;
    }
    .mega .mega-link::before {
        content: "";
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--color-accent-dark);
        opacity: 0.5;
        flex-shrink: 0;
    }
    .mega .mega-link:hover {
        background: var(--color-brand-soft);
    }
    .mega-link-count {
        margin-left: auto;
        font-size: 0.72rem;
        color: var(--color-faint);
    }
    .mega-foot {
        margin-top: auto;
        padding-top: 1rem;
        border-top: 1px solid var(--color-line);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        flex-wrap: wrap;
    }
    .mega .mega-viewall {
        padding: 0;
        border: none;
        border-bottom: 3px solid var(--color-accent);
        font-family: var(--font-display);
        font-size: 0.9rem;
        font-weight: 800;
        color: var(--color-ink);
        white-space: normal;
    }
    .mega .mega-viewall:hover {
        color: var(--color-brand);
        border-bottom-color: var(--color-brand);
    }
    .mega-foot-note {
        font-size: 0.8rem;
        line-height: 1.5;
        color: var(--color-muted);
    }
    .mega-foot-note strong {
        display: inline;
        margin-right: 0.4rem;
        color: var(--color-brand);
        font-weight: 700;
    }

    .toggle {
        display: none;
        width: 2.5rem;
        height: 2.5rem;
        border: 1px solid var(--color-line);
        border-radius: var(--radius-sm);
        background: transparent;
        cursor: pointer;
        position: relative;
    }
    .toggle span[aria-hidden] {
        position: absolute;
        inset: 50% 0.6rem auto 0.6rem;
        height: 2px;
        background: var(--color-ink);
        box-shadow:
            0 -6px 0 var(--color-ink),
            0 6px 0 var(--color-ink);
    }
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
        border: 0;
    }

    @media (width <= 1150px) {
        .toggle {
            display: block;
        }
        .mega {
            display: block;
            align-self: auto;
        }
        .chev {
            display: none;
        }
        .mega-panel {
            display: none;
        }
        .nav {
            position: absolute;
            inset: 100% 0 auto 0;
            flex-direction: column;
            align-items: stretch;
            gap: 0;
            background: var(--color-paper);
            border-bottom: 1px solid var(--color-line);
            padding: 0.5rem var(--spacing-page) 1rem;
            display: none;
        }
        .nav.open {
            display: flex;
        }
        .nav a {
            padding: 0.85rem 0;
        }
        .nav a::after {
            display: none;
        }
        .nav a.cta {
            margin: 0.85rem 0 0;
            justify-content: center;
        }
    }
</style>
