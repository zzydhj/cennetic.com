---
/**
 * 内页页头（全站点共用）：藏青→青蓝渐变带 + 浅色面包屑 + eyebrow + 大标题 + 副文案 + 可选 CTA。
 *
 * 对齐参考站内页那种「深色 Page Hero」：所有内页(公司页/政策页/归档/文章)共用这一块，
 * 版式与配色只在这一处定义；正文由调用方放在其后的 .shell 里。面包屑在这里是浅色变体
 * （深色底上），与正文里那套浅色底的 Breadcrumb 组件互不干扰。
 */
import type { Crumb } from "@components/ui/Breadcrumb.astro";

interface Props {
    title: string;
    eyebrow?: string;
    /** 纯文本副文案 */
    lede?: string;
    /** 需要按 HTML 渲染的副文案（归档 intro 等），优先于 lede */
    ledeHtml?: string;
    crumbs?: Crumb[];
    /** slim：更矮，适合文章这类内容型页 */
    slim?: boolean;
    /** 可选背景图（叠在渐变上，加暗保证白字可读） */
    image?: string;
    /** 文本对齐：left（默认，偏行动/工具页）| center（偏品牌页，如 About Us） */
    align?: "left" | "center";
}

const {
    title,
    eyebrow,
    lede,
    ledeHtml,
    crumbs = [],
    slim = false,
    image,
    align = "left",
} = Astro.props;
const center = align === "center";
---

<section
    class:list={[
        "page-hero",
        slim && "ph-slim",
        center && "ph-center",
        image && "ph-image",
    ]}
>
    {
        image && (
            <img
                class="ph-bg"
                src={image}
                alt=""
                aria-hidden="true"
                loading="eager"
                decoding="async"
            />
        )
    }
    <div class="ph-scrim" aria-hidden="true"></div>
    <div class="ph-glow" aria-hidden="true"></div>

    <div class="shell ph-inner">
        {
            crumbs.length > 0 && (
                <nav class="ph-crumbs" aria-label="Breadcrumb">
                    <ol>
                        {crumbs.map((c, i) => {
                            const last = i === crumbs.length - 1;
                            return (
                                <li>
                                    {c.path && !last ? (
                                        <a href={c.path}>{c.name}</a>
                                    ) : (
                                        <span
                                            aria-current={
                                                last ? "page" : undefined
                                            }
                                        >
                                            {c.name}
                                        </span>
                                    )}
                                    {!last && (
                                        <span class="ph-sep" aria-hidden="true">
                                            /
                                        </span>
                                    )}
                                </li>
                            );
                        })}
                    </ol>
                </nav>
            )
        }

        {eyebrow && <span class="ph-eyebrow">{eyebrow}</span>}
        <h1 class="ph-title">{title}</h1>
        {
            ledeHtml ? (
                <p class="ph-lede" set:html={ledeHtml} />
            ) : (
                lede && <p class="ph-lede">{lede}</p>
            )
        }

        <slot />
    </div>
</section>

<style>
    .page-hero {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        color: #fff;
        padding-block: clamp(2.75rem, 5vw, 4.5rem);
        margin-bottom: clamp(2rem, 4vw, 3rem);
        background:
            radial-gradient(
                900px 400px at 85% -10%,
                rgb(0 180 216 / 0.4),
                transparent 60%
            ),
            linear-gradient(
                135deg,
                var(--color-brand-deep) 0%,
                var(--color-brand) 55%,
                var(--color-accent-dark) 120%
            );
    }
    .ph-slim {
        padding-block: clamp(2rem, 4vw, 3rem);
    }
    .ph-bg {
        position: absolute;
        inset: 0;
        z-index: -2;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .ph-scrim {
        position: absolute;
        inset: 0;
        z-index: -1;
        background: linear-gradient(
            135deg,
            rgb(1 15 46 / 0.86) 0%,
            rgb(1 39 96 / 0.74) 50%,
            rgb(0 150 180 / 0.55) 120%
        );
    }
    /* 有背景图时遮罩加深，保证白字在车间/机械照片上仍可读 */
    .ph-image .ph-scrim {
        background: linear-gradient(
            135deg,
            rgb(1 15 46 / 0.9) 0%,
            rgb(1 39 96 / 0.82) 52%,
            rgb(0 120 150 / 0.72) 120%
        );
    }
    .ph-glow {
        position: absolute;
        inset: 0;
        z-index: -1;
        background-image:
            linear-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1px),
            linear-gradient(90deg, rgb(255 255 255 / 0.07) 1px, transparent 1px);
        background-size: 44px 44px;
        mask-image: radial-gradient(
            circle at 80% 10%,
            #000 0%,
            transparent 72%
        );
    }
    .ph-inner {
        /* 与 .shell 同宽上限(1400 居中),使 hero 文字左边缘与正文/页眉基线对齐 */
        max-width: var(--container-wide);
    }
    /* 居中变体：标题/副文案/面包屑/眉标整体居中（CTA 按钮由 PageLayout 的 ph-cta-center 居中） */
    .ph-center .ph-inner {
        text-align: center;
    }
    .ph-center .ph-crumbs ol {
        justify-content: center;
    }
    .ph-center .ph-lede {
        margin-inline: auto;
    }
    .ph-crumbs ol {
        list-style: none;
        margin: 0 0 1.1rem;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.82rem;
    }
    .ph-crumbs li {
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }
    .ph-crumbs a {
        color: rgb(255 255 255 / 0.72);
    }
    .ph-crumbs a:hover {
        color: #fff;
    }
    .ph-crumbs span {
        color: rgb(255 255 255 / 0.92);
    }
    .ph-sep {
        color: rgb(255 255 255 / 0.4) !important;
    }
    .ph-eyebrow {
        display: inline-block;
        margin-bottom: 0.9rem;
        padding: 0.35rem 0.85rem;
        border-radius: var(--radius-pill);
        background: rgb(255 255 255 / 0.16);
        border: 1px solid rgb(255 255 255 / 0.28);
        font-family: var(--font-display);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #fff;
    }
    .ph-title {
        color: #fff;
        font-size: clamp(1.9rem, 1.3rem + 2.6vw, 3rem);
        line-height: 1.14;
        letter-spacing: -0.02em;
        margin: 0;
        text-wrap: balance;
    }
    .ph-lede {
        margin: 1rem 0 0;
        max-width: 56ch;
        font-size: clamp(1rem, 0.9rem + 0.4vw, 1.12rem);
        line-height: 1.7;
        color: rgb(255 255 255 / 0.86);
    }
    .ph-lede :global(p) {
        margin: 0 0 0.6rem;
    }
    .ph-lede :global(p:last-child) {
        margin-bottom: 0;
    }
    .ph-lede :global(a) {
        color: var(--color-accent-on-dark);
        text-decoration: underline;
    }
</style>
