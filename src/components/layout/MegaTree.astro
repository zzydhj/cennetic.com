---
/**
 * Mega Menu 的子分类树：递归渲染任意层级的子分类，用 level 控制缩进。
 * 单独成组件是为了让 Header 不把层级写死成固定两层，分类再深也自动适配。
 */
import type { MegaNode } from "@lib/catalog.ts";
import MegaTree from "./MegaTree.astro";

interface Props {
    nodes: MegaNode[];
    level?: number;
}
const { nodes, level = 0 } = Astro.props;
---

{
    nodes.length > 0 && (
        <ul class:list={["mega-tree", `mega-tree-l${level}`]}>
            {nodes.map((n) => (
                <li>
                    <a href={n.path}>
                        <span class="mega-tree-name">{n.name}</span>
                        <span class="mega-count">{n.count}</span>
                    </a>
                    {n.children.length > 0 && (
                        <MegaTree nodes={n.children} level={level + 1} />
                    )}
                </li>
            ))}
        </ul>
    )
}

<style>
    /* 本组件自己渲染的元素带本组件的 scope id,样式必须写在这里(而非 Header),
       否则 Header 的 .mega-tree 规则因 cid 不同而命不中。 */
    .mega-tree {
        list-style: none;
        margin: 0 0 0.5rem;
        padding: 0;
        display: grid;
        gap: 0.32rem;
    }
    .mega-tree .mega-tree {
        margin: 0.32rem 0 0;
        padding-left: 0.75rem;
        border-left: 1px solid var(--color-line-soft);
        gap: 0.24rem;
    }
    .mega-tree a {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        padding: 0;
        border: none;
        font-family: var(--font-body);
        font-weight: 400;
        font-size: 0.85rem;
        line-height: 1.4;
        white-space: normal;
        color: var(--color-body);
    }
    .mega-tree a:hover {
        color: var(--color-brand);
    }
    .mega-tree-name {
        min-width: 0;
    }
    .mega-tree .mega-count {
        margin-left: auto;
        flex-shrink: 0;
        background: none;
        padding: 0;
        font-size: 0.7rem;
        color: var(--color-faint);
    }
</style>
