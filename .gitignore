# 构建产物
dist/
.astro/

# 迁移期原始缓存（体积大、可重新抓取，不入库）
.cache/

# 图片暂存区：与 public/images 内容重复，不入 Git（公开图直接存仓库，见下）
media-staging/

# 站点图片随仓库走：裸 clone 即可构建出完整站点，不再依赖源站在线。
# 曾经这里被 ignore + 靠 prebuild 从 WordPress 现拉，但那意味着
# 源站一下线就再也构建不出带图的站点，而且 DNS 切过来之后会变成从自己身上拉图。
# public/images/
public/pagefind/

# 依赖
node_modules/

# 环境变量（Decap OAuth token 等）
.env
.env.local
# Pages Functions / Workers 本地密钥；Supabase CLI 本地配置；后台 SPA 密钥
.dev.vars
.env.*.local
.supabase/
tmp/
admin/.env
admin/.env.local
admin/.dev.vars

# 编辑器与系统
.DS_Store
Thumbs.db
.vscode/
.idea/

# 日志
*.log
npm-debug.log*
