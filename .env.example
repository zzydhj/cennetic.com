# ============================================================================
# 内容后台/媒体迁移 环境变量契约（模板，不含真实密钥）
# 复制为 .env 使用；.env / .dev.vars 已被 .gitignore 屏蔽，绝不入库。
# 前台 npm run build 只读 git 快照文件，不需要任何下面的变量——这些只给
# scripts/cms/* 一次性/发布链路脚本 和 Pages 项目 B 的 Functions 使用。
# ============================================================================

# ── Supabase（内容库）────────────────────────────────────────────────────────
# 在 Supabase 项目 Settings → API 获取
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
# service_role 绕 RLS，仅 seed/snapshot 脚本与 Pages Function 服务端用；切勿放进前端/仓库
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>

# ── Cloudflare R2（媒体）─────────────────────────────────────────────────────
# push-media-to-r2.ts 与 admin 的 /api/media/sign 使用
R2_ACCOUNT_ID=<cf-account-id>
R2_ACCESS_KEY_ID=<r2-s3-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-s3-secret-access-key>
R2_BUCKET=cennetic-media
# 桶连接的自定义域（零出口费分发）
R2_PUBLIC_BASE=https://media.cennetic.com

# ── 发布链路：触发前台重建 ────────────────────────────────────────────────────
# 后台点发布 → Pages Function /api/publish → 触发 GH Action content-snapshot.yml
#   方式A(推荐)：workflow_dispatch，需 PAT(scopes: repo/actions)，仅存 Function env
GH_REPO=zzydhj/cennetic.com
GH_WORKFLOW_FILE=content-snapshot.yml
GH_WORKFLOW_DISPATCH_TOKEN=<github-pat-secret>
#   方式B(备选)：直接打 Pages Deploy Hook（URL 本身即密钥，别泄露）
PAGES_DEPLOY_HOOK_URL=<pages-deploy-hook-url>
