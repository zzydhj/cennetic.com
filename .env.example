# ============================================================================
# 环境变量契约（模板，不含真实密钥）
# 复制为 .env 使用；.env / .dev.vars / admin/.env* 已被 .gitignore 屏蔽，绝不入库。
#
# 前台构建（npm run build）只读 git 里的快照文件，不需要下面任何变量。
# 这些变量只服务于三个地方：
#   1) 本地脚本 scripts/cms/{seed-supabase,snapshot}.ts  → 本文件对应的 .env
#   2) GitHub Action「Content snapshot」                 → 仓库 Secrets
#   3) Cloudflare Pages（Functions 运行时 + 后台构建）    → Pages 变量/Secrets
# ============================================================================

# ── Supabase（内容库）────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
# 公钥（可公开，RLS 兜底）：后台 SPA 与 Pages Function 校验登录用
SUPABASE_ANON_KEY=sb_publishable_<...>
# 私钥（绕 RLS）：只给 seed/snapshot 脚本与 GH Action；切勿放进前端/仓库
SUPABASE_SECRET_KEY=sb_secret_<...>

# ── Cloudflare R2（媒体）─────────────────────────────────────────────────────
# 上传走 Pages Function + R2 绑定（functions/api/media/upload.ts），
# 因此**不需要**把 S3 密钥放进前端；下面三项仅供本地批量搬图脚本使用。
R2_ACCOUNT_ID=<cf-account-id>
R2_ACCESS_KEY_ID=<r2-s3-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-s3-secret-access-key>
R2_BUCKET=cennetic-com
# 桶连接的自定义域（零出口费分发）；函数缺省会用它
R2_PUBLIC_BASE=https://media.cennetic.com

# ── 发布链路：后台 → 线上 ────────────────────────────────────────────────────
# /admin 点「发布上线」→ Pages Function /api/publish → GitHub workflow_dispatch
# → .github/workflows/content-snapshot.yml 跑 snapshot + 回归闸 + 提交 main → Pages 重建
GH_OWNER=zzydhj
GH_REPO=cennetic.com
GH_WORKFLOW=content-snapshot.yml
# fine-grained PAT，只授予该仓库 Actions: write（Read repository contents 也需要，用于取 workflow 列表）
GH_API_TOKEN=<github-pat-secret>

# ============================================================================
# 对照：云端要配什么（名字要与这里一致）
#   GitHub 仓库 Secrets：SUPABASE_URL、SUPABASE_SECRET_KEY
#   Cloudflare Pages（Production）：
#     变量  VITE_SUPABASE_URL、VITE_SUPABASE_ANON_KEY（后台 SPA + 函数校验登录）
#     变量  GH_OWNER、GH_REPO、GH_WORKFLOW
#     Secret GH_API_TOKEN
#     R2 绑定 变量名 MEDIA → 桶 cennetic-com
# ============================================================================
